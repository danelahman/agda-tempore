------------------------------------------------------------------------
-- The syntactic equivalence is contained in the equational theory.    --
--                                                                    --
-- `_≐ᵛ_`/`_≐ᶜ_` are the congruence generated by the two places terms  --
-- carry data no rule may inspect: a `var`'s grade bound and the       --
-- renaming-plus-boxed-value an `unbox` stores. `_==_` has one rule    --
-- per former, and since `unbox-cong` compares its two nodes at the    --
-- cell they name, each `≐` constructor now maps to exactly one `==`   --
-- rule. The two leaves that carry a bound go by `bound-irr`.          --
--                                                                    --
-- The converse fails, and should: `_==_` has the βη axioms.           --
------------------------------------------------------------------------

open import Syntax.Grades
open import Syntax.LanguageSpec
open import Syntax.Operations

open import Util.Equality

module EquationalTheory.Alignment (S : LanguageSpec) where

open LanguageSpec S
open GradeSystemInterface Grades
open Operations Ops

open import Syntax.Contexts      S
open import Syntax.Language      S
open import Syntax.RenActions    S
open import Syntax.Renamings     S
open import Syntax.Substitutions S
open import Syntax.Types         S

open import Syntax.Terms.Equivalence S
open import Syntax.Substitutions.Swap.Variables S using (bound-irr)

open import EquationalTheory.EquationalTheory S

mutual

  ≐ᵛ→== : ∀ {Γ A} {V V' : Γ ⊢V⦂ A} → V ≐ᵛ V' → Γ ⊢V⦂ V == V'

  -- the two bounds are equal (`≾ᵣ-irrelevant` under `fun-ext`), so the values
  -- are the same term
  ≐ᵛ→== (var-≐ {f = f} {f' = f'}) rewrite bound-irr f f' = V-refl
  ≐ᵛ→== const-≐          = V-refl
  ≐ᵛ→== ⋆-≐              = V-refl
  ≐ᵛ→== (pair-≐ e₁ e₂)   = ⦉⦊-cong (≐ᵛ→== e₁) (≐ᵛ→== e₂)
  -- `CType` has the one former, so `lam-cong`'s `B ‼ ε` is `lam-≐`'s `C`
  ≐ᵛ→== (lam-≐ {C = _ ‼ _} e) = lam-cong (≐ᶜ→== e)

  ≐ᶜ→== : ∀ {Γ C} {M M' : Γ ⊢C⦂ C} → M ≐ᶜ M' → Γ ⊢C⦂ M == M'

  ≐ᶜ→== (return-≐ e)     = return-cong (≐ᵛ→== e)
  ≐ᶜ→== (seq-≐ e₁ e₂)    = seq-cong (≐ᶜ→== e₁) (≐ᶜ→== e₂)
  ≐ᶜ→== (app-≐ e₁ e₂)    = app-cong (≐ᵛ→== e₁) (≐ᵛ→== e₂)
  ≐ᶜ→== (match-≐ e₁ e₂)  = match-cong (≐ᵛ→== e₁) (≐ᶜ→== e₂)
  ≐ᶜ→== (absurd-≐ e)     = absurd-cong (≐ᵛ→== e)
  ≐ᶜ→== (perform-≐ e₁ e₂) = perform-cong (≐ᵛ→== e₁) (≐ᶜ→== e₂)
  ≐ᶜ→== (delay-≐ e)      = delay-cong (≐ᶜ→== e)
  ≐ᶜ→== (handle-≐ e eH eN) =
    handle-cong (≐ᶜ→== e) (λ op ε'' → ≐ᶜ→== (eH op ε'')) (≐ᶜ→== eN)
  -- the premise transfers on the nose: both relations compare the cell
  ≐ᶜ→== (unbox-≐ hw e)   = unbox-cong hw (≐ᶜ→== e)
  ≐ᶜ→== (box-≐ e₁ e₂)    = box-cong (≐ᵛ→== e₁) (≐ᶜ→== e₂)
  ≐ᶜ→== (coerce-≐ e)     = coerce-cong (≐ᶜ→== e)
