------------------------------------------------------------------------
-- The free graded monad generated by the algebraic operations and     --
-- delays, on discretely-indexed presheaves.                           --
--                                                                    --
-- The monad `Tᵒ A ε` is graded by the *effect* grades `ε : E`. Its    --
-- values are wellfounded trees built from                             --
--                                                                    --
--   * `leaf`       : a returned value of `A` (grade `uₑ`);             --
--   * `op-node`    : an algebraic operation `op`, whose continuation   --
--                    receives the arity at every world reachable by    --
--                    the operation's effect `op-grade op`;             --
--   * `delay-node` : a delay by `τ` ticks, whose continuation lives at --
--                    every world reachable by the effect `of-natᵉ τ`.  --
--                                                                    --
-- World movement uses the *effect* accessibility `_⊑ᵉ[_]_`. Because    --
-- the presheaves are discrete, there is no monotonicity side-condition --
-- on the continuations (unlike the earlier time-graded formalisation). --
--                                                                    --
-- This module provides the monad's *core* structure — functor, unit,   --
-- multiplication, the monad laws, sub-effecting `T-≤` (the `coerce`     --
-- node), and the `[-]`-strength `strᵀ`. The algebraic operations and   --
-- delays are in `…Monad.Effects`.                                      --
------------------------------------------------------------------------

open import Syntax.Grades
open import Syntax.LanguageSpec
open import Syntax.Operations

open import DenotationalSemantics.Model.World
open import DenotationalSemantics.Model.GroundTypes
import DenotationalSemantics.Model.Example.PSh.Base as B
import DenotationalSemantics.Model.Example.PSh.Modality.Future as F

module DenotationalSemantics.Model.Example.PSh.Monad.Core
         (S : LanguageSpec)
         (Wld : World (LanguageSpec.Grades S))
         (GTy : GroundTypes S (B.PShCat (LanguageSpec.Grades S) Wld)
                              (F.PShFut (LanguageSpec.Grades S) Wld))
       where

open import Data.Nat using (ℕ)
open import Data.Product using (_,_)

open import Util.Equality

open LanguageSpec S
open GradeSystemInterface Grades
open Operations Ops
open World Wld
open import DenotationalSemantics.Model.Example.PSh.Base Grades Wld
open import DenotationalSemantics.Model.Example.PSh.Modality.Future Grades Wld
open GroundTypes GTy

open import DenotationalSemantics.Model.Category
open Category PShCat using (mapˣᵐ; sndᵐ; ×ᵐ-assoc; ×ᵐ-assoc⁻¹)

-- The tree underlying the monad

data Tˢ (A : PSh) : E → W → Set where
  leaf       : ∀ {w} → carrier A w → Tˢ A uₑ w
  op-node    : ∀ {ε w} → (op : Op) → carrier ⟦ param op ⟧ᵍ w
             → (∀ {w'} → w ⊑ᵉ[ op-grade op ] w' → carrier ⟦ arity op ⟧ᵍ w' → Tˢ A ε w')
             → Tˢ A (op-grade op ·ₑ ε) w
  delay-node : ∀ {ε w} → (τ : ℕ)
             → (∀ {w'} → w ⊑ᵉ[ of-natᵉ τ ] w' → Tˢ A ε w')
             → Tˢ A (of-natᵉ τ ·ₑ ε) w
  -- sub-effecting node (the semantics of `coerce`): the exact grade is
  -- kept exact on `leaf`/`op-node`/`delay-node` — which is what makes
  -- the monad laws hold — and a computation of grade `ε` may be weakened
  -- to any `ε'` with `ε ≾ₑ ε'` by wrapping it in a `sub` node.
  sub        : ∀ {ε ε' w} → ε ≾ₑ ε' → Tˢ A ε w → Tˢ A ε' w

-- Packaged as a (discrete) presheaf

Tᵒ : PSh → E → PSh
Tᵒ A ε = psh (λ w → Tˢ A ε w)

-- On-the-nose grade coercion: transport of a tree along an equality of
-- effect grades (used to absorb the propositional monoid laws of `·ₑ`).

ε-substˢ : ∀ {A ε ε' w} → ε ≡ ε' → Tˢ A ε w → Tˢ A ε' w
ε-substˢ refl t = t

-- FUNCTOR

Tˢᶠ : ∀ {A B ε w} → A →ᵖ B → Tˢ A ε w → Tˢ B ε w
Tˢᶠ f (leaf x)          = leaf (app f x)
Tˢᶠ f (op-node op p k)  = op-node op p (λ q y → Tˢᶠ f (k q y))
Tˢᶠ f (delay-node τ k)  = delay-node τ (λ q → Tˢᶠ f (k q))
Tˢᶠ f (sub p t)         = sub p (Tˢᶠ f t)

Tᶠ : ∀ {A B ε} → A →ᵖ B → Tᵒ A ε →ᵖ Tᵒ B ε
Tᶠ f = pmap (Tˢᶠ f)

-- Sub-effecting (the semantics of `coerce`): a plain map, no functor
-- laws (the equational theory only asks `coerce` to be a proof-
-- irrelevant congruence).

T-≤ : ∀ {A ε ε'} → ε ≾ₑ ε' → Tᵒ A ε →ᵖ Tᵒ A ε'
T-≤ p = pmap (sub p)

Tˢᶠ-id : ∀ {A ε w} → (t : Tˢ A ε w) → Tˢᶠ idᵖ t ≡ t
Tˢᶠ-id (leaf x)         = refl
Tˢᶠ-id (op-node op p k) =
  cong (op-node op p) (ifun-ext (fun-ext (λ q → fun-ext (λ y → Tˢᶠ-id (k q y)))))
Tˢᶠ-id (delay-node τ k) =
  cong (delay-node τ) (ifun-ext (fun-ext (λ q → Tˢᶠ-id (k q))))
Tˢᶠ-id (sub p t) =
  cong (sub p) (Tˢᶠ-id t)

Tᶠ-id : ∀ {A ε} → Tᶠ {A} {A} {ε} idᵖ ≡ idᵖ
Tᶠ-id = →ᵖ-ext (λ t → Tˢᶠ-id t)

Tˢᶠ-∘ : ∀ {A B C ε w} → (g : B →ᵖ C) → (f : A →ᵖ B) → (t : Tˢ A ε w)
      → Tˢᶠ (g ∘ᵖ f) t ≡ Tˢᶠ g (Tˢᶠ f t)
Tˢᶠ-∘ g f (leaf x)         = refl
Tˢᶠ-∘ g f (op-node op p k) =
  cong (op-node op p) (ifun-ext (fun-ext (λ q → fun-ext (λ y → Tˢᶠ-∘ g f (k q y)))))
Tˢᶠ-∘ g f (delay-node τ k) =
  cong (delay-node τ) (ifun-ext (fun-ext (λ q → Tˢᶠ-∘ g f (k q))))
Tˢᶠ-∘ g f (sub p t) =
  cong (sub p) (Tˢᶠ-∘ g f t)

Tᶠ-∘ : ∀ {A B C ε} → (g : B →ᵖ C) → (f : A →ᵖ B)
     → Tᶠ {A} {C} {ε} (g ∘ᵖ f) ≡ Tᶠ g ∘ᵖ Tᶠ f
Tᶠ-∘ g f = →ᵖ-ext (λ t → Tˢᶠ-∘ g f t)

-- T-≤ (sub-effecting) is natural (on the nose)

T-≤-nat : ∀ {A B ε ε'} → (f : A →ᵖ B) → (p : ε ≾ₑ ε')
        → Tᶠ f ∘ᵖ T-≤ p ≡ T-≤ p ∘ᵖ Tᶠ f
T-≤-nat f p = →ᵖ-ext (λ t → refl)

-- `ε-substˢ` commutes with the functorial action

ε-substˢ-Tˢᶠ : ∀ {A B ε ε' w} → (p : ε ≡ ε') → (f : A →ᵖ B) → (t : Tˢ A ε w)
             → ε-substˢ p (Tˢᶠ f t) ≡ Tˢᶠ f (ε-substˢ p t)
ε-substˢ-Tˢᶠ refl f t = refl

-- UNIT

ηᵀ : ∀ {A} → A →ᵖ Tᵒ A uₑ
ηᵀ = pmap leaf

ηᵀ-nat : ∀ {A B} → (f : A →ᵖ B) → ηᵀ ∘ᵖ f ≡ Tᶠ f ∘ᵖ ηᵀ
ηᵀ-nat f = →ᵖ-ext (λ x → refl)

-- MULTIPLICATION

μˢ : ∀ {A ε ε' w} → Tˢ (Tᵒ A ε') ε w → Tˢ A (ε ·ₑ ε') w
μˢ {ε' = ε'} (leaf t) =
  ε-substˢ (sym (·ₑ-identityˡ ε')) t
μˢ {ε' = ε'} (op-node {ε = ε₀} op p k) =
  ε-substˢ (sym (·ₑ-assoc (op-grade op) ε₀ ε')) (op-node op p (λ q y → μˢ (k q y)))
μˢ {ε' = ε'} (delay-node {ε = ε₀} τ k) =
  ε-substˢ (sym (·ₑ-assoc (of-natᵉ τ) ε₀ ε')) (delay-node τ (λ q → μˢ (k q)))
μˢ {ε' = ε'} (sub p t) =
  sub (·ₑ-monoˡ-≾ₑ p) (μˢ t)

μᵀ : ∀ {A ε ε'} → Tᵒ (Tᵒ A ε') ε →ᵖ Tᵒ A (ε ·ₑ ε')
μᵀ = pmap μˢ

μˢ-nat : ∀ {A B ε ε' w} → (f : A →ᵖ B) → (t : Tˢ (Tᵒ A ε') ε w)
       → μˢ (Tˢᶠ (Tᶠ f) t) ≡ Tˢᶠ f (μˢ t)
μˢ-nat f (leaf t) = ε-substˢ-Tˢᶠ (sym (·ₑ-identityˡ _)) f t
μˢ-nat {ε' = ε'} f (op-node {ε = ε₀} op p k) =
  trans
    (cong (ε-substˢ (sym (·ₑ-assoc (op-grade op) ε₀ ε')))
      (cong (op-node op p)
        (ifun-ext (fun-ext (λ q → fun-ext (λ y → μˢ-nat f (k q y)))))))
    (ε-substˢ-Tˢᶠ (sym (·ₑ-assoc (op-grade op) ε₀ ε')) f
      (op-node op p (λ q y → μˢ (k q y))))
μˢ-nat {ε' = ε'} f (delay-node {ε = ε₀} τ k) =
  trans
    (cong (ε-substˢ (sym (·ₑ-assoc (of-natᵉ τ) ε₀ ε')))
      (cong (delay-node τ)
        (ifun-ext (fun-ext (λ q → μˢ-nat f (k q))))))
    (ε-substˢ-Tˢᶠ (sym (·ₑ-assoc (of-natᵉ τ) ε₀ ε')) f
      (delay-node τ (λ q → μˢ (k q))))
μˢ-nat f (sub p t) =
  cong (sub (·ₑ-monoˡ-≾ₑ p)) (μˢ-nat f t)

μᵀ-nat : ∀ {A B ε ε'} → (f : A →ᵖ B)
       → μᵀ {ε = ε} {ε' = ε'} ∘ᵖ Tᶠ (Tᶠ f) ≡ Tᶠ f ∘ᵖ μᵀ
μᵀ-nat f = →ᵖ-ext (λ t → μˢ-nat f t)

-- On-the-nose grade coercion at the presheaf level

ε-substᵀ : ∀ {A ε ε'} → ε ≡ ε' → Tᵒ A ε →ᵖ Tᵒ A ε'
ε-substᵀ p = pmap (ε-substˢ p)

ε-substᵀ-refl : ∀ {A ε} → ε-substᵀ {A} {ε} refl ≡ idᵖ
ε-substᵀ-refl = →ᵖ-ext (λ t → refl)

ε-substˢ-trans : ∀ {A ε ε' ε'' w} → (p : ε ≡ ε') → (q : ε' ≡ ε'') → (t : Tˢ A ε w)
               → ε-substˢ q (ε-substˢ p t) ≡ ε-substˢ (trans p q) t
ε-substˢ-trans refl refl t = refl

ε-substᵀ-trans : ∀ {A ε ε' ε''} → (p : ε ≡ ε') → (q : ε' ≡ ε'')
               → ε-substᵀ q ∘ᵖ ε-substᵀ p ≡ ε-substᵀ {A} (trans p q)
ε-substᵀ-trans p q = →ᵖ-ext (λ t → ε-substˢ-trans p q t)

-- `ε-substˢ` commutes with the sub-effecting node (on either side)

sub-substˢ : ∀ {A ε₀ ε₁ ε₂ w} → (P : ε₁ ≾ₑ ε₂) → (r : ε₀ ≡ ε₁) → (t : Tˢ A ε₀ w)
           → sub P (ε-substˢ r t) ≡ sub (subst (_≾ₑ ε₂) (sym r) P) t
sub-substˢ P refl t = refl

ε-substˢ-sub : ∀ {A ε₁ ε₂ ε₃ w} → (P : ε₁ ≾ₑ ε₂) → (r : ε₂ ≡ ε₃) → (t : Tˢ A ε₁ w)
             → ε-substˢ r (sub P t) ≡ sub (subst (ε₁ ≾ₑ_) r P) t
ε-substˢ-sub P refl t = refl

-- MONAD LAWS

-- First identity law (holds definitionally: `μˢ (leaf t)` unfolds to the coercion)

T-μ∘η≡id : ∀ {A ε} → μᵀ {A} {uₑ} {ε} ∘ᵖ ηᵀ {Tᵒ A ε} ≡ ε-substᵀ (sym (·ₑ-identityˡ ε))
T-μ∘η≡id = →ᵖ-ext (λ t → refl)

-- `ε-substˢ` pushes through the operation and delay nodes

ε-substˢ-op : ∀ {A ε ε' w} → (op : Op) → (v : carrier ⟦ param op ⟧ᵍ w) → (p : ε ≡ ε')
            → (k : ∀ {w'} → w ⊑ᵉ[ op-grade op ] w' → carrier ⟦ arity op ⟧ᵍ w' → Tˢ A ε w')
            → ε-substˢ (cong (op-grade op ·ₑ_) p) (op-node op v k)
            ≡ op-node op v (λ q y → ε-substˢ p (k q y))
ε-substˢ-op op v refl k = refl

ε-substˢ-delay : ∀ {A ε ε' w} → (τ : ℕ) → (p : ε ≡ ε')
               → (k : ∀ {w'} → w ⊑ᵉ[ of-natᵉ τ ] w' → Tˢ A ε w')
               → ε-substˢ (cong (of-natᵉ τ ·ₑ_) p) (delay-node τ k)
               ≡ delay-node τ (λ q → ε-substˢ p (k q))
ε-substˢ-delay τ refl k = refl

-- Second identity law

μˢ-identity₂ : ∀ {A ε w} → (t : Tˢ A ε w)
             → μˢ (Tˢᶠ ηᵀ t) ≡ ε-substˢ (sym (·ₑ-identityʳ ε)) t
μˢ-identity₂ (leaf x) =
  cong (λ p → ε-substˢ p (leaf x)) uip
μˢ-identity₂ (op-node {ε = ε₀} op v k) =
  trans
    (cong (ε-substˢ (sym (·ₑ-assoc (op-grade op) ε₀ uₑ)))
      (cong (op-node op v)
        (ifun-ext (fun-ext (λ q → fun-ext (λ y → μˢ-identity₂ (k q y)))))))
    (trans
      (cong (ε-substˢ (sym (·ₑ-assoc (op-grade op) ε₀ uₑ)))
        (sym (ε-substˢ-op op v (sym (·ₑ-identityʳ ε₀)) k)))
      (trans
        (ε-substˢ-trans (cong (op-grade op ·ₑ_) (sym (·ₑ-identityʳ ε₀)))
          (sym (·ₑ-assoc (op-grade op) ε₀ uₑ)) (op-node op v k))
        (cong (λ p → ε-substˢ p (op-node op v k)) uip)))
μˢ-identity₂ (delay-node {ε = ε₀} τ k) =
  trans
    (cong (ε-substˢ (sym (·ₑ-assoc (of-natᵉ τ) ε₀ uₑ)))
      (cong (delay-node τ)
        (ifun-ext (fun-ext (λ q → μˢ-identity₂ (k q))))))
    (trans
      (cong (ε-substˢ (sym (·ₑ-assoc (of-natᵉ τ) ε₀ uₑ)))
        (sym (ε-substˢ-delay τ (sym (·ₑ-identityʳ ε₀)) k)))
      (trans
        (ε-substˢ-trans (cong (of-natᵉ τ ·ₑ_) (sym (·ₑ-identityʳ ε₀)))
          (sym (·ₑ-assoc (of-natᵉ τ) ε₀ uₑ)) (delay-node τ k))
        (cong (λ p → ε-substˢ p (delay-node τ k)) uip)))
μˢ-identity₂ (sub p t) =
  trans (cong (sub (·ₑ-monoˡ-≾ₑ p)) (μˢ-identity₂ t))
  (trans (sub-substˢ (·ₑ-monoˡ-≾ₑ p) (sym (·ₑ-identityʳ _)) t)
  (trans (cong (λ P → sub P t) (≾ₑ-irrelevant _ _))
         (sym (ε-substˢ-sub p (sym (·ₑ-identityʳ _)) t))))

T-μ∘Tη≡id : ∀ {A ε} → μᵀ {A} {ε} {uₑ} ∘ᵖ Tᶠ (ηᵀ {A}) ≡ ε-substᵀ (sym (·ₑ-identityʳ ε))
T-μ∘Tη≡id = →ᵖ-ext (λ t → μˢ-identity₂ t)

-- `ε-substˢ` commutes with multiplication (on the outer grade)

ε-substˢ-μˢ : ∀ {A ε ε₁ δ w} → (p : ε ≡ ε₁) → (t : Tˢ (Tᵒ A δ) ε w)
            → μˢ (ε-substˢ p t) ≡ ε-substˢ (cong (_·ₑ δ) p) (μˢ t)
ε-substˢ-μˢ refl t = refl

-- Associativity law

μˢ-assoc : ∀ {A ε ε' ε'' w} → (t : Tˢ (Tᵒ (Tᵒ A ε'') ε') ε w)
         → μˢ {ε = ε} {ε' = ε' ·ₑ ε''} (Tˢᶠ (μᵀ {A} {ε'} {ε''}) t)
         ≡ ε-substˢ (·ₑ-assoc ε ε' ε'') (μˢ (μˢ t))
μˢ-assoc {ε' = ε'} {ε'' = ε''} (leaf s) =
  sym
    (trans
      (cong (ε-substˢ (·ₑ-assoc uₑ ε' ε'')) (ε-substˢ-μˢ (sym (·ₑ-identityˡ ε')) s))
      (trans
        (ε-substˢ-trans (cong (_·ₑ ε'') (sym (·ₑ-identityˡ ε'))) (·ₑ-assoc uₑ ε' ε'') (μˢ s))
        (cong (λ p → ε-substˢ p (μˢ s)) uip)))
μˢ-assoc {ε' = ε'} {ε'' = ε''} (op-node {ε = ε₀} op v k) =
  let BASE = op-node op v (λ q y → μˢ (μˢ (k q y))) in
  trans
    (cong (ε-substˢ (sym (·ₑ-assoc (op-grade op) ε₀ (ε' ·ₑ ε''))))
      (cong (op-node op v)
        (ifun-ext (fun-ext (λ q → fun-ext (λ y → μˢ-assoc (k q y)))))))
  (trans
    (cong (ε-substˢ (sym (·ₑ-assoc (op-grade op) ε₀ (ε' ·ₑ ε''))))
      (sym (ε-substˢ-op op v (·ₑ-assoc ε₀ ε' ε'') (λ q y → μˢ (μˢ (k q y))))))
  (trans
    (ε-substˢ-trans (cong (op-grade op ·ₑ_) (·ₑ-assoc ε₀ ε' ε''))
      (sym (·ₑ-assoc (op-grade op) ε₀ (ε' ·ₑ ε''))) BASE)
  (trans
    (cong (λ p → ε-substˢ p BASE) uip)
    (sym
      (trans
        (cong (ε-substˢ (·ₑ-assoc (op-grade op ·ₑ ε₀) ε' ε''))
          (trans
            (ε-substˢ-μˢ (sym (·ₑ-assoc (op-grade op) ε₀ ε')) (op-node op v (λ q y → μˢ (k q y))))
            (ε-substˢ-trans (sym (·ₑ-assoc (op-grade op) (ε₀ ·ₑ ε') ε''))
              (cong (_·ₑ ε'') (sym (·ₑ-assoc (op-grade op) ε₀ ε'))) BASE)))
        (ε-substˢ-trans
          (trans (sym (·ₑ-assoc (op-grade op) (ε₀ ·ₑ ε') ε''))
            (cong (_·ₑ ε'') (sym (·ₑ-assoc (op-grade op) ε₀ ε'))))
          (·ₑ-assoc (op-grade op ·ₑ ε₀) ε' ε'') BASE))))))
μˢ-assoc {ε' = ε'} {ε'' = ε''} (delay-node {ε = ε₀} τ k) =
  let BASE = delay-node τ (λ q → μˢ (μˢ (k q))) in
  trans
    (cong (ε-substˢ (sym (·ₑ-assoc (of-natᵉ τ) ε₀ (ε' ·ₑ ε''))))
      (cong (delay-node τ)
        (ifun-ext (fun-ext (λ q → μˢ-assoc (k q))))))
  (trans
    (cong (ε-substˢ (sym (·ₑ-assoc (of-natᵉ τ) ε₀ (ε' ·ₑ ε''))))
      (sym (ε-substˢ-delay τ (·ₑ-assoc ε₀ ε' ε'') (λ q → μˢ (μˢ (k q))))))
  (trans
    (ε-substˢ-trans (cong (of-natᵉ τ ·ₑ_) (·ₑ-assoc ε₀ ε' ε''))
      (sym (·ₑ-assoc (of-natᵉ τ) ε₀ (ε' ·ₑ ε''))) BASE)
  (trans
    (cong (λ p → ε-substˢ p BASE) uip)
    (sym
      (trans
        (cong (ε-substˢ (·ₑ-assoc (of-natᵉ τ ·ₑ ε₀) ε' ε''))
          (trans
            (ε-substˢ-μˢ (sym (·ₑ-assoc (of-natᵉ τ) ε₀ ε')) (delay-node τ (λ q → μˢ (k q))))
            (ε-substˢ-trans (sym (·ₑ-assoc (of-natᵉ τ) (ε₀ ·ₑ ε') ε''))
              (cong (_·ₑ ε'') (sym (·ₑ-assoc (of-natᵉ τ) ε₀ ε'))) BASE)))
        (ε-substˢ-trans
          (trans (sym (·ₑ-assoc (of-natᵉ τ) (ε₀ ·ₑ ε') ε''))
            (cong (_·ₑ ε'') (sym (·ₑ-assoc (of-natᵉ τ) ε₀ ε'))))
          (·ₑ-assoc (of-natᵉ τ ·ₑ ε₀) ε' ε'') BASE))))))
μˢ-assoc {ε' = ε'} {ε'' = ε''} (sub p t) =
  trans (cong (sub (·ₑ-monoˡ-≾ₑ p)) (μˢ-assoc t))
  (trans (sub-substˢ (·ₑ-monoˡ-≾ₑ p) (·ₑ-assoc _ ε' ε'') (μˢ (μˢ t)))
  (trans (cong (λ P → sub P (μˢ (μˢ t))) (≾ₑ-irrelevant _ _))
         (sym (ε-substˢ-sub (·ₑ-monoˡ-≾ₑ (·ₑ-monoˡ-≾ₑ p)) (·ₑ-assoc _ ε' ε'') (μˢ (μˢ t))))))

T-μ∘μ≡μ∘Tμ : ∀ {A ε ε' ε''}
           → μᵀ {A} {ε} {ε' ·ₑ ε''} ∘ᵖ Tᶠ (μᵀ {A} {ε'} {ε''})
           ≡ ε-substᵀ (·ₑ-assoc ε ε' ε'') ∘ᵖ μᵀ ∘ᵖ μᵀ
T-μ∘μ≡μ∘Tμ = →ᵖ-ext (λ t → μˢ-assoc t)

-- STRENGTH

-- The `[-]`-strength of the monad. It is part of the monad's core
-- structure (making it a *strong* graded monad); the box on the left is
-- graded by the resource projection `mapᵉ ε` of the computation's effect.

-- Coercion of a resource-accessibility witness along an equality of grades.

⊑ʳ-coe : ∀ {ρ ρ' w w'} → ρ ≡ ρ' → w ⊑ʳ[ ρ ] w' → w ⊑ʳ[ ρ' ] w'
⊑ʳ-coe e = ⊑ʳ-mono (≾ᵣ-reflexive e)

-- The strength threads a box `[ mapᵉ ε ] A` along the tree: at every
-- effect step it advances the box (via `⊑ᵉ-resource` + `⊑ʳ-trans`), and
-- pairs the extracted `A` with the returned `B` at the leaves.

strˢ : ∀ {A B ε w}
     → carrier ([ mapᵉ ε ]ᵒ A) w → Tˢ B ε w → Tˢ (A ×ᵖ B) ε w
strˢ box (leaf b) =
  leaf (box (⊑ʳ-coe (sym map-uᵉ) ⊑ʳ-refl) , b)
strˢ box (op-node op v k) =
  op-node op v (λ q y →
    strˢ (λ r → box (⊑ʳ-coe (sym map-·ᵉ) (⊑ʳ-trans (⊑ᵉ-resource q) r))) (k q y))
strˢ box (delay-node τ k) =
  delay-node τ (λ q →
    strˢ (λ r → box (⊑ʳ-coe (sym map-·ᵉ) (⊑ʳ-trans (⊑ᵉ-resource q) r))) (k q))
strˢ box (sub p t) =
  sub p (strˢ (λ r → box (⊑ʳ-mono (map-monotoneᵉ p) r)) t)

strᵀ : ∀ {A B ε} → [ mapᵉ ε ]ᵒ A ×ᵖ Tᵒ B ε →ᵖ Tᵒ (A ×ᵖ B) ε
strᵀ = pmap (λ { (a , t) → strˢ a t })

-- Strength is natural

strˢ-nat : ∀ {A A' B B' ε w} → (f : A →ᵖ A') → (g : B →ᵖ B')
         → (box : carrier ([ mapᵉ ε ]ᵒ A) w) → (t : Tˢ B ε w)
         → strˢ (λ r → app f (box r)) (Tˢᶠ g t) ≡ Tˢᶠ (mapˣᵐ f g) (strˢ box t)
strˢ-nat f g box (leaf b)          = refl
strˢ-nat f g box (op-node op v k)  =
  cong (op-node op v)
    (ifun-ext (fun-ext (λ q → fun-ext (λ y →
      strˢ-nat f g (λ r → box (⊑ʳ-coe (sym map-·ᵉ) (⊑ʳ-trans (⊑ᵉ-resource q) r))) (k q y)))))
strˢ-nat f g box (delay-node τ k)  =
  cong (delay-node τ)
    (ifun-ext (fun-ext (λ q →
      strˢ-nat f g (λ r → box (⊑ʳ-coe (sym map-·ᵉ) (⊑ʳ-trans (⊑ᵉ-resource q) r))) (k q))))
strˢ-nat f g box (sub p t)         =
  cong (sub p) (strˢ-nat f g (λ r → box (⊑ʳ-mono (map-monotoneᵉ p) r)) t)

strᵀ-nat : ∀ {A A' B B' ε} → (f : A →ᵖ A') → (g : B →ᵖ B')
         → strᵀ {A'} {B'} ∘ᵖ mapˣᵐ ([ mapᵉ ε ]ᶠ f) (Tᶠ g)
         ≡ Tᶠ (mapˣᵐ f g) ∘ᵖ strᵀ {A} {B}
strᵀ-nat f g = →ᵖ-ext (λ { (a , t) → strˢ-nat f g a t })

-- Strength projects away on the second component

strˢ-snd : ∀ {A B ε w}
         → (box : carrier ([ mapᵉ ε ]ᵒ A) w) → (t : Tˢ B ε w)
         → Tˢᶠ sndᵐ (strˢ box t) ≡ t
strˢ-snd box (leaf b)          = refl
strˢ-snd box (op-node op v k)  =
  cong (op-node op v)
    (ifun-ext (fun-ext (λ q → fun-ext (λ y →
      strˢ-snd (λ r → box (⊑ʳ-coe (sym map-·ᵉ) (⊑ʳ-trans (⊑ᵉ-resource q) r))) (k q y)))))
strˢ-snd box (delay-node τ k)  =
  cong (delay-node τ)
    (ifun-ext (fun-ext (λ q →
      strˢ-snd (λ r → box (⊑ʳ-coe (sym map-·ᵉ) (⊑ʳ-trans (⊑ᵉ-resource q) r))) (k q))))
strˢ-snd box (sub p t)         =
  cong (sub p) (strˢ-snd (λ r → box (⊑ʳ-mono (map-monotoneᵉ p) r)) t)

strᵀ-sndᵐ : ∀ {A B ε} → Tᶠ sndᵐ ∘ᵖ strᵀ {A} {B} {ε} ≡ sndᵐ
strᵀ-sndᵐ = →ᵖ-ext (λ { (a , t) → strˢ-snd a t })

-- STRENGTH COHERENCE LAWS

-- Unit: on a returned value the strength extracts the boxed component at
-- the reflexive world and pairs it. Both sides produce the very same leaf
-- (the box witness `⊑ʳ-coe (sym map-uᵉ) ⊑ʳ-refl` on the left is, by
-- definition of `⊑ʳ-coe`, the `[]-≤ ∘ ε` witness on the right).

strᵀ-ηᵀ : ∀ {A B}
        → strᵀ {A} {B} {uₑ} ∘ᵖ mapˣᵐ idᵖ ηᵀ
        ≡ ηᵀ {A ×ᵖ B} ∘ᵖ mapˣᵐ (ε ∘ᵖ []-≤ (≾ᵣ-reflexive (sym map-uᵉ))) idᵖ
strᵀ-ηᵀ = →ᵖ-ext (λ { (box , b) → refl })

-- Associativity with the product: strength-ing with a monoidal box agrees
-- with strength-ing componentwise. The `[]-monoidal` box `λ p → (a p , b p)`
-- reassociates to two nested strengths; a clean induction on the tree.

strˢ-assoc : ∀ {A B C ε w}
           → (a : carrier ([ mapᵉ ε ]ᵒ A) w)
           → (b : carrier ([ mapᵉ ε ]ᵒ B) w)
           → (t : Tˢ C ε w)
           → Tˢᶠ ×ᵐ-assoc (strˢ (λ p → a p , b p) t) ≡ strˢ a (strˢ b t)
strˢ-assoc a b (leaf c)          = refl
strˢ-assoc a b (op-node op v k)  =
  cong (op-node op v)
    (ifun-ext (fun-ext (λ q → fun-ext (λ y →
      strˢ-assoc
        (λ r → a (⊑ʳ-coe (sym map-·ᵉ) (⊑ʳ-trans (⊑ᵉ-resource q) r)))
        (λ r → b (⊑ʳ-coe (sym map-·ᵉ) (⊑ʳ-trans (⊑ᵉ-resource q) r)))
        (k q y)))))
strˢ-assoc a b (delay-node τ k)  =
  cong (delay-node τ)
    (ifun-ext (fun-ext (λ q →
      strˢ-assoc
        (λ r → a (⊑ʳ-coe (sym map-·ᵉ) (⊑ʳ-trans (⊑ᵉ-resource q) r)))
        (λ r → b (⊑ʳ-coe (sym map-·ᵉ) (⊑ʳ-trans (⊑ᵉ-resource q) r)))
        (k q))))
strˢ-assoc a b (sub p t)         =
  cong (sub p)
    (strˢ-assoc
      (λ r → a (⊑ʳ-mono (map-monotoneᵉ p) r))
      (λ r → b (⊑ʳ-mono (map-monotoneᵉ p) r))
      t)

strᵀ-assoc : ∀ {A B C ε}
           → Tᶠ ×ᵐ-assoc ∘ᵖ strᵀ {A ×ᵖ B} {C} {ε}
             ∘ᵖ mapˣᵐ []-monoidal idᵖ ∘ᵖ ×ᵐ-assoc⁻¹
           ≡ strᵀ {A} {B ×ᵖ C} {ε} ∘ᵖ mapˣᵐ idᵖ (strᵀ {B} {C} {ε})
strᵀ-assoc = →ᵖ-ext (λ { (a , b , t) → strˢ-assoc a b t })

-- Multiplication: the strength commutes with the monad multiplication. The
-- proof needs two auxiliary facts about `strˢ`: it only depends on its box
-- argument up to `⊑ʳ-irrelevant`, and it commutes with the on-the-nose grade
-- coercions `ε-substˢ` that `μˢ` inserts at every node.

strˢ-cong : ∀ {A B ε w} {a a' : carrier ([ mapᵉ ε ]ᵒ A) w}
          → (∀ {w'} (r : w ⊑ʳ[ mapᵉ ε ] w') → a r ≡ a' r)
          → (t : Tˢ B ε w) → strˢ a t ≡ strˢ a' t
strˢ-cong {A} {B} {ε} {w} h t =
  cong (λ (box : carrier ([ mapᵉ ε ]ᵒ A) w) → strˢ box t)
    (ifun-ext (λ {w'} → fun-ext (λ r → h r)))

strˢ-ε-substˢ : ∀ {A B ε ε₁ w} → (p : ε ≡ ε₁)
              → (a : carrier ([ mapᵉ ε₁ ]ᵒ A) w)
              → (t : Tˢ B ε w)
              → strˢ a (ε-substˢ p t)
              ≡ ε-substˢ p (strˢ (λ r → a (⊑ʳ-coe (cong mapᵉ p) r)) t)
strˢ-ε-substˢ refl a t = strˢ-cong (λ r → cong a (⊑ʳ-irrelevant _ _)) t

-- The core fact: threading the box through `μˢ` agrees with threading it
-- once at the outer layer (splitting the box with `δ`) and then strength-ing
-- the inner layer via `Tˢᶠ strᵀ`. Every node contributes an `ε-substˢ`
-- coercion (from `μˢ`) that `strˢ` commutes past (`strˢ-ε-substˢ`), and the
-- box witnesses on the two sides agree up to `⊑ʳ-irrelevant` (`strˢ-cong`).

strˢ-μˢ : ∀ {A B ε ε' w}
        → (a : carrier ([ mapᵉ (ε ·ₑ ε') ]ᵒ A) w)
        → (t : Tˢ (Tᵒ B ε') ε w)
        → strˢ a (μˢ t)
        ≡ μˢ (Tˢᶠ (strᵀ {A} {B} {ε'})
               (strˢ (λ p q → a (⊑ʳ-mono (≾ᵣ-reflexive (sym map-·ᵉ)) (⊑ʳ-trans p q))) t))
strˢ-μˢ {ε' = ε'} a (leaf s) =
  trans (strˢ-ε-substˢ (sym (·ₑ-identityˡ ε')) a s)
        (cong (ε-substˢ (sym (·ₑ-identityˡ ε')))
          (strˢ-cong (λ r → cong a (⊑ʳ-irrelevant _ _)) s))
strˢ-μˢ {ε' = ε'} a (op-node {ε = ε₀} op v k) =
  trans (strˢ-ε-substˢ (sym (·ₑ-assoc (op-grade op) ε₀ ε')) a
           (op-node op v (λ q y → μˢ (k q y))))
        (cong (ε-substˢ (sym (·ₑ-assoc (op-grade op) ε₀ ε')))
          (cong (op-node op v)
            (ifun-ext (fun-ext (λ q → fun-ext (λ y →
              trans (strˢ-μˢ _ (k q y))
                    (cong (λ z → μˢ (Tˢᶠ (strᵀ {ε = ε'}) z))
                      (strˢ-cong
                        (λ r → ifun-ext (fun-ext (λ q'' → cong a (⊑ʳ-irrelevant _ _))))
                        (k q y)))))))))
strˢ-μˢ {ε' = ε'} a (delay-node {ε = ε₀} τ k) =
  trans (strˢ-ε-substˢ (sym (·ₑ-assoc (of-natᵉ τ) ε₀ ε')) a
           (delay-node τ (λ q → μˢ (k q))))
        (cong (ε-substˢ (sym (·ₑ-assoc (of-natᵉ τ) ε₀ ε')))
          (cong (delay-node τ)
            (ifun-ext (fun-ext (λ q →
              trans (strˢ-μˢ _ (k q))
                    (cong (λ z → μˢ (Tˢᶠ (strᵀ {ε = ε'}) z))
                      (strˢ-cong
                        (λ r → ifun-ext (fun-ext (λ q'' → cong a (⊑ʳ-irrelevant _ _))))
                        (k q))))))))
strˢ-μˢ {ε' = ε'} a (sub p t) =
  trans (cong (sub (·ₑ-monoˡ-≾ₑ p)) (strˢ-μˢ _ t))
        (cong (λ z → sub (·ₑ-monoˡ-≾ₑ p) (μˢ (Tˢᶠ (strᵀ {ε = ε'}) z)))
          (strˢ-cong
            (λ r → ifun-ext (fun-ext (λ q'' → cong a (⊑ʳ-irrelevant _ _))))
            t))

strᵀ-μᵀ : ∀ {A B ε ε'}
        → strᵀ {A} {B} {ε ·ₑ ε'} ∘ᵖ mapˣᵐ idᵖ (μᵀ {B} {ε} {ε'})
        ≡ μᵀ {A ×ᵖ B} {ε} {ε'}
          ∘ᵖ Tᶠ (strᵀ {A} {B} {ε'})
          ∘ᵖ strᵀ {[ mapᵉ ε' ]ᵒ A} {Tᵒ B ε'} {ε}
          ∘ᵖ mapˣᵐ (δ ∘ᵖ []-≤ (≾ᵣ-reflexive (sym map-·ᵉ))) idᵖ
strᵀ-μᵀ = →ᵖ-ext (λ { (a , t) → strˢ-μˢ a t })
