-- The resource grade a `τ`-delay moves through, in the two forms the
-- delay-collapsing rules need: a zero delay moves through no resource, and
-- consecutive delays move through the product of theirs. `of-natʳ` is only
-- *propositionally* a monoid morphism, so both are transports.

delay-uᵣ : mapᵉ (of-natᵉ 0) ≡ uᵣ
delay-uᵣ = trans map-of-natᵉ of-natʳ-zero

delay-·ᵣ : ∀ {τ₁ τ₂}
         → mapᵉ (of-natᵉ τ₁) ·ᵣ mapᵉ (of-natᵉ τ₂) ≡ mapᵉ (of-natᵉ (τ₁ + τ₂))
delay-·ᵣ = trans (cong₂ _·ᵣ_ map-of-natᵉ map-of-natᵉ)
                 (trans (sym of-natʳ-plus) (sym map-of-natᵉ))

-- Splitting a `τ₁ + τ₂` step into a `τ₁` step followed by a `τ₂` one.

⊑-split : ∀ {τ₁ τ₂ w w' w''}
        → w ⊑[ mapᵉ (of-natᵉ τ₁) ] w' → w' ⊑[ mapᵉ (of-natᵉ τ₂) ] w''
        → w ⊑[ mapᵉ (of-natᵉ (τ₁ + τ₂)) ] w''
⊑-split q₁ q₂ = ⊑-mono (≾ᵣ-reflexive delay-·ᵣ) (⊑-trans q₁ q₂)

-- The zero-delay step from a world to itself.

⊑-delay0 : ∀ {w} → w ⊑[ mapᵉ (of-natᵉ 0) ] w
⊑-delay0 = ⊑-mono (≾ᵣ-reflexive (sym delay-uᵣ)) ⊑-refl

-- The effect grades the two delay collapses regrade along. By UIP any proof
-- of these will do, so the rules quantify over one and these are the canonical
-- choices to feed them.

delay0ᵉ : ∀ {ε} → ε ≡ of-natᵉ 0 ·ₑ ε
delay0ᵉ {ε} = sym (trans (cong (_·ₑ ε) of-natᵉ-zero) (·ₑ-identityˡ ε))

delay+ᵉ : ∀ {τ₁ τ₂ ε} → of-natᵉ (τ₁ + τ₂) ·ₑ ε ≡ of-natᵉ τ₁ ·ₑ (of-natᵉ τ₂ ·ₑ ε)
delay+ᵉ {τ₁} {τ₂} {ε} =
  trans (cong (_·ₑ ε) of-natᵉ-plus) (·ₑ-assoc (of-natᵉ τ₁) (of-natᵉ τ₂) ε)

-- The tree underlying the monad, its transport, and its bisimulation,
-- defined simultaneously (induction-induction-recursion).

mutual

  data Tˢ (A : PSh) : E → W → Set where
    leaf       : ∀ {w} → carrier A w → Tˢ A uₑ w
    op-node    : ∀ {ε w} → (op : Op) → carrier ⟦ param op ⟧ᵍ w
               → (k : ∀ {w'} → w ⊑[ mapᵉ (op-grade op) ] w' → carrier ⟦ arity op ⟧ᵍ w' → Tˢ A ε w')
               → (k-cong : ∀ {w'} (q : w ⊑[ mapᵉ (op-grade op) ] w')
                             {y y' : carrier ⟦ arity op ⟧ᵍ w'}
                         → _≈_ ⟦ arity op ⟧ᵍ y y' → k q y ≈ᵗ k q y')
               → (k-nat : ∀ {w' w''} (q : w ⊑[ mapᵉ (op-grade op) ] w') (r : w' ⊑[ uᵣ ] w'')
                            (y : carrier ⟦ arity op ⟧ᵍ w')
                        → k (⊑ρ∘ᵘ q r) (transport ⟦ arity op ⟧ᵍ r y) ≈ᵗ transportᵗ r (k q y))
               → Tˢ A (op-grade op ·ₑ ε) w
    delay-node : ∀ {ε w} → (τ : ℕ)
               → (k : ∀ {w'} → w ⊑[ mapᵉ (of-natᵉ τ) ] w' → Tˢ A ε w')
               → (k-nat : ∀ {w' w''} (q : w ⊑[ mapᵉ (of-natᵉ τ) ] w') (r : w' ⊑[ uᵣ ] w'')
                        → k (⊑ρ∘ᵘ q r) ≈ᵗ transportᵗ r (k q))
               → Tˢ A (of-natᵉ τ ·ₑ ε) w
    sub        : ∀ {ε ε' w} → ε ≾ₑ ε' → Tˢ A ε w → Tˢ A ε' w

  data _≈ᵗ_ {A : PSh} : {ε : E} {w : W} → Tˢ A ε w → Tˢ A ε w → Set where
    leaf-≈  : ∀ {w} {x y : carrier A w} → _≈_ A x y → leaf x ≈ᵗ leaf y
    op-≈    : ∀ {ε w} {op : Op} {v v' : carrier ⟦ param op ⟧ᵍ w}
                {k k' : ∀ {w'} → w ⊑[ mapᵉ (op-grade op) ] w' → carrier ⟦ arity op ⟧ᵍ w' → Tˢ A ε w'}
                {kc  : ∀ {w'} (q : w ⊑[ mapᵉ (op-grade op) ] w') {y y' : carrier ⟦ arity op ⟧ᵍ w'}
                     → _≈_ ⟦ arity op ⟧ᵍ y y' → k q y ≈ᵗ k q y'}
                {kn  : ∀ {w' w''} (q : w ⊑[ mapᵉ (op-grade op) ] w') (r : w' ⊑[ uᵣ ] w'')
                         (y : carrier ⟦ arity op ⟧ᵍ w')
                     → k (⊑ρ∘ᵘ q r) (transport ⟦ arity op ⟧ᵍ r y) ≈ᵗ transportᵗ r (k q y)}
                {kc' : ∀ {w'} (q : w ⊑[ mapᵉ (op-grade op) ] w') {y y' : carrier ⟦ arity op ⟧ᵍ w'}
                     → _≈_ ⟦ arity op ⟧ᵍ y y' → k' q y ≈ᵗ k' q y'}
                {kn' : ∀ {w' w''} (q : w ⊑[ mapᵉ (op-grade op) ] w') (r : w' ⊑[ uᵣ ] w'')
                         (y : carrier ⟦ arity op ⟧ᵍ w')
                     → k' (⊑ρ∘ᵘ q r) (transport ⟦ arity op ⟧ᵍ r y) ≈ᵗ transportᵗ r (k' q y)}
            → _≈_ ⟦ param op ⟧ᵍ v v'
            → (∀ {w'} (q : w ⊑[ mapᵉ (op-grade op) ] w') (y : carrier ⟦ arity op ⟧ᵍ w')
                 → k q y ≈ᵗ k' q y)
            → op-node op v k kc kn ≈ᵗ op-node op v' k' kc' kn'
    delay-≈ : ∀ {ε w} {τ : ℕ}
                {k k' : ∀ {w'} → w ⊑[ mapᵉ (of-natᵉ τ) ] w' → Tˢ A ε w'}
                {kn  : ∀ {w' w''} (q : w ⊑[ mapᵉ (of-natᵉ τ) ] w') (r : w' ⊑[ uᵣ ] w'')
                     → k (⊑ρ∘ᵘ q r) ≈ᵗ transportᵗ r (k q)}
                {kn' : ∀ {w' w''} (q : w ⊑[ mapᵉ (of-natᵉ τ) ] w') (r : w' ⊑[ uᵣ ] w'')
                     → k' (⊑ρ∘ᵘ q r) ≈ᵗ transportᵗ r (k' q)}
            → (∀ {w'} (q : w ⊑[ mapᵉ (of-natᵉ τ) ] w') → k q ≈ᵗ k' q)
            → delay-node τ k kn ≈ᵗ delay-node τ k' kn'
    sub-≈   : ∀ {ε ε' w} {e e' : ε ≾ₑ ε'} {t t' : Tˢ A ε w}
            → t ≈ᵗ t' → sub e t ≈ᵗ sub e' t'

    -- Sub-effecting nodes are invisible: reduction discards a `coerce`
    -- (`⟨ S , coerce p M ⟩ ↝ ⟨ S , M ⟩`), so an equality preserved by
    -- reduction must not see the `sub` node it leaves behind. Collapsing them
    -- is what makes `T-≤` a coercion (`T-≤-refl` / `T-≤-trans`).

    sub-u   : ∀ {ε w} {t : Tˢ A ε w}
            → sub ≾ₑ-refl t ≈ᵗ t
    sub-∘   : ∀ {ε ε' ε'' w} {e : ε ≾ₑ ε'} {e' : ε' ≾ₑ ε''} {t : Tˢ A ε w}
            → sub e' (sub e t) ≈ᵗ sub (≾ₑ-trans e e') t

    -- A `sub` may be pushed under a delay, at a grade factoring through the
    -- delay's own (`of-natᵉ τ ·ₑ_`): a coercion of the residual effect leaves
    -- the delay untouched. This is what makes sub-effecting commute with the
    -- multiplication in the inner grade, which the `↝*` closure needs.

    sub-delay : ∀ {ε ε' w} {τ : ℕ} {e : ε ≾ₑ ε'}
                  {k : ∀ {w'} → w ⊑[ mapᵉ (of-natᵉ τ) ] w' → Tˢ A ε w'}
                  {kn  : ∀ {w' w''} (q : w ⊑[ mapᵉ (of-natᵉ τ) ] w') (r : w' ⊑[ uᵣ ] w'')
                       → k (⊑ρ∘ᵘ q r) ≈ᵗ transportᵗ r (k q)}
                  {kn' : ∀ {w' w''} (q : w ⊑[ mapᵉ (of-natᵉ τ) ] w') (r : w' ⊑[ uᵣ ] w'')
                       → sub e (k (⊑ρ∘ᵘ q r)) ≈ᵗ transportᵗ r (sub e (k q))}
              → sub (·ₑ-monoʳ-≾ₑ e) (delay-node τ k kn)
              ≈ᵗ delay-node τ (λ q → sub e (k q)) kn'

    -- Likewise for an operation, at a grade factoring through the operation's
    -- own (`op-grade op ·ₑ_`). This is what makes sub-effecting commute with
    -- the multiplication in the inner grade at `op`-nodes, and hence what makes
    -- `μ` monotone in the inner grade.
    --
    -- Soundness of this rule rests on handlers being *ambivalent* in the
    -- residual grade (`Handlerˢ.clause-mono`): the fold selects the clause
    -- `h op ε''` by the residual grade, so a coercion pushed under an operation
    -- changes which clause is applied, and only a handler whose clauses agree
    -- across such a coercion is left unaffected.

    sub-op : ∀ {ε ε' w} {op : Op} {e : ε ≾ₑ ε'}
               {v : carrier ⟦ param op ⟧ᵍ w}
               {k : ∀ {w'} → w ⊑[ mapᵉ (op-grade op) ] w' → carrier ⟦ arity op ⟧ᵍ w' → Tˢ A ε w'}
               {kc  : ∀ {w'} (q : w ⊑[ mapᵉ (op-grade op) ] w')
                        {y y' : carrier ⟦ arity op ⟧ᵍ w'}
                    → _≈_ ⟦ arity op ⟧ᵍ y y' → k q y ≈ᵗ k q y'}
               {kn  : ∀ {w' w''} (q : w ⊑[ mapᵉ (op-grade op) ] w') (r : w' ⊑[ uᵣ ] w'')
                        (y : carrier ⟦ arity op ⟧ᵍ w')
                    → k (⊑ρ∘ᵘ q r) (transport ⟦ arity op ⟧ᵍ r y) ≈ᵗ transportᵗ r (k q y)}
               {kc' : ∀ {w'} (q : w ⊑[ mapᵉ (op-grade op) ] w')
                        {y y' : carrier ⟦ arity op ⟧ᵍ w'}
                    → _≈_ ⟦ arity op ⟧ᵍ y y' → sub e (k q y) ≈ᵗ sub e (k q y')}
               {kn' : ∀ {w' w''} (q : w ⊑[ mapᵉ (op-grade op) ] w') (r : w' ⊑[ uᵣ ] w'')
                        (y : carrier ⟦ arity op ⟧ᵍ w')
                    → sub e (k (⊑ρ∘ᵘ q r) (transport ⟦ arity op ⟧ᵍ r y))
                    ≈ᵗ transportᵗ r (sub e (k q y))}
           → sub (·ₑ-monoʳ-≾ₑ e) (op-node op v k kc kn)
           ≈ᵗ op-node op v (λ q y → sub e (k q y)) kc' kn'


    -- Delays are the passage of time, not observable nodes. A delay by no
    -- time is no delay: at grade `mapᵉ (of-natᵉ 0) = uᵣ` the node's Kripke
    -- continuation is already determined by its value at the world itself
    -- (that is its own `k-nat`), so the node *is* that value.

    delay-zero : ∀ {ε w}
                   {k : ∀ {w'} → w ⊑[ mapᵉ (of-natᵉ 0) ] w' → Tˢ A ε w'}
                   {kn : ∀ {w' w''} (q : w ⊑[ mapᵉ (of-natᵉ 0) ] w') (r : w' ⊑[ uᵣ ] w'')
                       → k (⊑ρ∘ᵘ q r) ≈ᵗ transportᵗ r (k q)}
                   {q₀ : w ⊑[ mapᵉ (of-natᵉ 0) ] w}
                 → (e : ε ≡ of-natᵉ 0 ·ₑ ε)
               → delay-node 0 k kn ≈ᵗ subst (λ z → Tˢ A z w) e (k q₀)

    -- And two consecutive delays are the one delay by their sum: the outer
    -- node's continuation only ever reaches the inner one through the composite
    -- step (`⊑-split`), which is what the syntactic rule's `⟨⟩-μ-ren` records.

    delay-plus : ∀ {ε w} {τ₁ τ₂ : ℕ}
                   {k : ∀ {w'} → w ⊑[ mapᵉ (of-natᵉ (τ₁ + τ₂)) ] w' → Tˢ A ε w'}
                   {kn : ∀ {w' w''} (q : w ⊑[ mapᵉ (of-natᵉ (τ₁ + τ₂)) ] w')
                           (r : w' ⊑[ uᵣ ] w'')
                       → k (⊑ρ∘ᵘ q r) ≈ᵗ transportᵗ r (k q)}
                   {k' : ∀ {w'} → w ⊑[ mapᵉ (of-natᵉ τ₁) ] w'
                       → ∀ {w''} → w' ⊑[ mapᵉ (of-natᵉ τ₂) ] w'' → Tˢ A ε w''}
                   {kn₂ : ∀ {w'} (q₁ : w ⊑[ mapᵉ (of-natᵉ τ₁) ] w')
                        → ∀ {w'' w'''} (q₂ : w' ⊑[ mapᵉ (of-natᵉ τ₂) ] w'')
                            (r : w'' ⊑[ uᵣ ] w''')
                        → k' q₁ (⊑ρ∘ᵘ q₂ r) ≈ᵗ transportᵗ r (k' q₁ q₂)}
                   {kn₁ : ∀ {w' w''} (q₁ : w ⊑[ mapᵉ (of-natᵉ τ₁) ] w') (r : w' ⊑[ uᵣ ] w'')
                        → delay-node τ₂ (k' (⊑ρ∘ᵘ q₁ r)) (kn₂ (⊑ρ∘ᵘ q₁ r))
                        ≈ᵗ transportᵗ r (delay-node τ₂ (k' q₁) (kn₂ q₁))}
                 -- the two-step continuation only ever reaches the one-step one
                 -- through the composite step; stated up to `≈ᵗ` so that the
                 -- rule applies without matching accessibility witnesses
                 → (∀ {w' w''} (q₁ : w ⊑[ mapᵉ (of-natᵉ τ₁) ] w')
                      (q₂ : w' ⊑[ mapᵉ (of-natᵉ τ₂) ] w'')
                    → k' q₁ q₂ ≈ᵗ k (⊑-split q₁ q₂))
                 → (e : of-natᵉ (τ₁ + τ₂) ·ₑ ε ≡ of-natᵉ τ₁ ·ₑ (of-natᵉ τ₂ ·ₑ ε))
               → delay-node τ₁ (λ q₁ → delay-node τ₂ (k' q₁) (kn₂ q₁)) kn₁
               ≈ᵗ subst (λ z → Tˢ A z w) e (delay-node (τ₁ + τ₂) k kn)

    -- The congruence rules alone do not make `_≈ᵗ_` an equivalence in the
    -- presence of the laws above, so symmetry and transitivity are explicit.

    ≈ᵗ-sym   : ∀ {ε w} {t t' : Tˢ A ε w}
             → t ≈ᵗ t' → t' ≈ᵗ t
    ≈ᵗ-trans : ∀ {ε w} {t t' t'' : Tˢ A ε w}
             → t ≈ᵗ t' → t' ≈ᵗ t'' → t ≈ᵗ t''

  -- Transport of a tree along unit-accessibility. The top node is
  -- reindexed and its continuation is precomposed with the witness;
  -- the reindexed continuation's coherence witnesses are rebuilt from
  -- the stored ones (using proof irrelevance of accessibility witnesses).

  transportᵗ : ∀ {A ε w w'} → w ⊑[ uᵣ ] w' → Tˢ A ε w → Tˢ A ε w'
  transportᵗ {A} p (leaf x)             = leaf (transport A p x)
  transportᵗ {A} p (op-node op v k kc kn) =
    op-node op (transport ⟦ param op ⟧ᵍ p v)
      (λ q y → k (⊑ᵘ∘ρ p q) y)
      (λ q e → kc (⊑ᵘ∘ρ p q) e)
      (λ q r y → subst
                   (λ z → k z (transport ⟦ arity op ⟧ᵍ r y) ≈ᵗ transportᵗ r (k (⊑ᵘ∘ρ p q) y))
                   (⊑-irrelevant _ _) (kn (⊑ᵘ∘ρ p q) r y))
  transportᵗ p (delay-node τ k kn) =
    delay-node τ (λ q → k (⊑ᵘ∘ρ p q))
      (λ q r → subst
                 (λ z → k z ≈ᵗ transportᵗ r (k (⊑ᵘ∘ρ p q)))
                 (⊑-irrelevant _ _) (kn (⊑ᵘ∘ρ p q) r))
  transportᵗ p (sub e t)            = sub e (transportᵗ p t)

infix 4 _≈ᵗ_

-- The bisimulation is an equivalence

≈ᵗ-refl : ∀ {A ε w} (t : Tˢ A ε w) → t ≈ᵗ t
≈ᵗ-refl {A} (leaf x)             = leaf-≈ (≈-refl A)
≈ᵗ-refl (op-node op v k kc kn)   = op-≈ (≈-refl ⟦ param op ⟧ᵍ) (λ q y → ≈ᵗ-refl (k q y))
≈ᵗ-refl (delay-node τ k kn)      = delay-≈ (λ q → ≈ᵗ-refl (k q))
≈ᵗ-refl (sub e t)                = sub-≈ (≈ᵗ-refl t)

-- (`≈ᵗ-sym` and `≈ᵗ-trans` are constructors of `_≈ᵗ_`; see above.)

≡→≈ᵗ : ∀ {A ε w} {t t' : Tˢ A ε w} → t ≡ t' → t ≈ᵗ t'
≡→≈ᵗ refl = ≈ᵗ-refl _

-- A delay node is independent of its stored coherence witness. Stated with the
-- witnesses explicit, since they are never inferable from a `≈ᵗ` goal.

delay-irrᵗ : ∀ {A ε w} {τ : ℕ}
           → (k : ∀ {w'} → w ⊑[ mapᵉ (of-natᵉ τ) ] w' → Tˢ A ε w')
           → (kn kn' : ∀ {w' w''} (q : w ⊑[ mapᵉ (of-natᵉ τ) ] w') (r : w' ⊑[ uᵣ ] w'')
                     → k (⊑ρ∘ᵘ q r) ≈ᵗ transportᵗ r (k q))
           → delay-node τ k kn ≈ᵗ delay-node τ k kn'
delay-irrᵗ k kn kn' = delay-≈ (λ q → ≈ᵗ-refl (k q))

-- `sub-u`/`sub-∘` at *any* witnesses of the required orderings. The
-- constructors are stated at `≾ₑ-refl`/`≾ₑ-trans`, which is the standard
-- presentation; sub-effecting witnesses being proof-irrelevant, these recover
-- the form the recursions meet, where the witness comes from elsewhere.

sub-uᵗ : ∀ {A ε w} → (e : ε ≾ₑ ε) → (t : Tˢ A ε w) → sub e t ≈ᵗ t
sub-uᵗ e t rewrite ≾ₑ-irrelevant e ≾ₑ-refl = sub-u

sub-∘ᵗ : ∀ {A ε ε' ε'' w} → (e : ε ≾ₑ ε') → (e' : ε' ≾ₑ ε'') → (e'' : ε ≾ₑ ε'')
       → (t : Tˢ A ε w) → sub e' (sub e t) ≈ᵗ sub e'' t
sub-∘ᵗ e e' e'' t rewrite ≾ₑ-irrelevant e'' (≾ₑ-trans e e') = sub-∘

-- `sub-delay` with its coherence witness pinned. The witness is never inferable
-- from a `≈ᵗ` goal (as for `delay-≈`), so it is constructed here: outside the
-- defining block `transportᵗ` reduces, and it pushes straight through a `sub`.

sub-delayᵗ : ∀ {A ε ε' w} {τ : ℕ} → (e : ε ≾ₑ ε')
           → (k : ∀ {w'} → w ⊑[ mapᵉ (of-natᵉ τ) ] w' → Tˢ A ε w')
           → (kn : ∀ {w' w''} (q : w ⊑[ mapᵉ (of-natᵉ τ) ] w') (r : w' ⊑[ uᵣ ] w'')
                 → k (⊑ρ∘ᵘ q r) ≈ᵗ transportᵗ r (k q))
           → sub (·ₑ-monoʳ-≾ₑ e) (delay-node τ k kn)
           ≈ᵗ delay-node τ (λ q → sub e (k q)) (λ q r → sub-≈ (kn q r))
sub-delayᵗ e k kn = sub-delay

-- `sub-op` with its coherence witnesses pinned (as for `sub-delayᵗ`).

sub-opᵗ : ∀ {A ε ε' w} {op : Op} → (e : ε ≾ₑ ε')
        → (v : carrier ⟦ param op ⟧ᵍ w)
        → (k : ∀ {w'} → w ⊑[ mapᵉ (op-grade op) ] w' → carrier ⟦ arity op ⟧ᵍ w' → Tˢ A ε w')
        → (kc : ∀ {w'} (q : w ⊑[ mapᵉ (op-grade op) ] w')
                  {y y' : carrier ⟦ arity op ⟧ᵍ w'}
              → _≈_ ⟦ arity op ⟧ᵍ y y' → k q y ≈ᵗ k q y')
        → (kn : ∀ {w' w''} (q : w ⊑[ mapᵉ (op-grade op) ] w') (r : w' ⊑[ uᵣ ] w'')
                  (y : carrier ⟦ arity op ⟧ᵍ w')
              → k (⊑ρ∘ᵘ q r) (transport ⟦ arity op ⟧ᵍ r y) ≈ᵗ transportᵗ r (k q y))
        → sub (·ₑ-monoʳ-≾ₑ e) (op-node op v k kc kn)
        ≈ᵗ op-node op v (λ q y → sub e (k q y))
             (λ q ey → sub-≈ (kc q ey)) (λ q r y → sub-≈ (kn q r y))
sub-opᵗ e v k kc kn = sub-op

-- Transport of a tree along an equality of grades. Defined as `subst` (rather
-- than by matching `refl`) so that it *is* the transport the delay-collapsing
-- rules `delay-zero`/`delay-plus` are stated with, which — being inside the
-- defining block — cannot mention this name.

ε-substˢ : ∀ {A ε ε' w} → ε ≡ ε' → Tˢ A ε w → Tˢ A ε' w
ε-substˢ {A} {w = w} e = subst (λ z → Tˢ A z w) e

ε-substˢ-congᵗ : ∀ {A ε ε' w} (p : ε ≡ ε') {t t' : Tˢ A ε w}
               → t ≈ᵗ t' → ε-substˢ p t ≈ᵗ ε-substˢ p t'
ε-substˢ-congᵗ refl e = e

ε-substˢ-trans : ∀ {A ε ε' ε'' w} → (p : ε ≡ ε') → (q : ε' ≡ ε'') → (t : Tˢ A ε w)
               → ε-substˢ q (ε-substˢ p t) ≡ ε-substˢ (trans p q) t
ε-substˢ-trans refl refl t = refl

transportᵗ-ε-substˢ : ∀ {A ε ε' w w'} (p : w ⊑[ uᵣ ] w') (e : ε ≡ ε') (t : Tˢ A ε w)
                    → transportᵗ p (ε-substˢ e t) ≡ ε-substˢ e (transportᵗ p t)
transportᵗ-ε-substˢ p refl t = refl

-- Transport respects `_≈ᵗ_` and satisfies the presheaf laws (up to `_≈ᵗ_`).

transportᵗ-cong : ∀ {A ε w w'} (p : w ⊑[ uᵣ ] w') {t t' : Tˢ A ε w}
                → t ≈ᵗ t' → transportᵗ p t ≈ᵗ transportᵗ p t'
transportᵗ-cong {A} p (leaf-≈ e)          = leaf-≈ (transport-cong A p e)
transportᵗ-cong p (op-≈ {op = op} ev ek)  = op-≈ (transport-cong ⟦ param op ⟧ᵍ p ev) (λ q y → ek (⊑ᵘ∘ρ p q) y)
transportᵗ-cong p (delay-≈ ek)            = delay-≈ (λ q → ek (⊑ᵘ∘ρ p q))
transportᵗ-cong p (sub-≈ et)              = sub-≈ (transportᵗ-cong p et)
transportᵗ-cong p sub-u                   = sub-uᵗ _ _
transportᵗ-cong p sub-∘                   = sub-∘ᵗ _ _ _ _
transportᵗ-cong p sub-delay               = sub-delay
transportᵗ-cong p sub-op                  = sub-op
-- transport commutes with both delay collapses definitionally on the nodes;
-- what is left is that the zero-delay's continuation is determined by its
-- value at the world itself (its own `kn`), resp. that transporting before or
-- after splitting a step agrees (witness irrelevance)
transportᵗ-cong p (delay-zero {k = k} {kn = kn} {q₀ = q₀} e) =
  ≈ᵗ-trans (delay-zero {q₀ = ⊑-delay0} e)
    (≈ᵗ-trans (ε-substˢ-congᵗ e (≈ᵗ-trans (≡→≈ᵗ (cong k (⊑-irrelevant _ _))) (kn q₀ p)))
              (≡→≈ᵗ (sym (transportᵗ-ε-substˢ p e (k q₀)))))
transportᵗ-cong p (delay-plus {τ₁ = τ₁} {τ₂ = τ₂} {k = k} {kn = kn} hk e) =
  ≈ᵗ-trans (delay-plus (λ q₁ q₂ → ≈ᵗ-trans (hk (⊑ᵘ∘ρ p q₁) q₂)
                                           (≡→≈ᵗ (cong k (⊑-irrelevant _ _)))) e)
           (≡→≈ᵗ (sym (transportᵗ-ε-substˢ p e (delay-node (τ₁ + τ₂) k kn))))
transportᵗ-cong p (≈ᵗ-sym et)             = ≈ᵗ-sym (transportᵗ-cong p et)
transportᵗ-cong p (≈ᵗ-trans et et')       = ≈ᵗ-trans (transportᵗ-cong p et) (transportᵗ-cong p et')

transportᵗ-refl : ∀ {A ε w} (t : Tˢ A ε w) → transportᵗ ⊑-refl t ≈ᵗ t
transportᵗ-refl {A} (leaf x)             = leaf-≈ (transport-refl A x)
transportᵗ-refl (op-node op v k kc kn)   = op-≈ (transport-refl ⟦ param op ⟧ᵍ v) (λ q y → ≡→≈ᵗ (cong (λ z → k z y) (⊑-irrelevant _ _)))
transportᵗ-refl (delay-node τ k kn)      = delay-≈ (λ q → ≡→≈ᵗ (cong k (⊑-irrelevant _ _)))
transportᵗ-refl (sub e t)                = sub-≈ (transportᵗ-refl t)

transportᵗ-trans : ∀ {A ε w w' w''} (p : w ⊑[ uᵣ ] w') (q : w' ⊑[ uᵣ ] w'') (t : Tˢ A ε w)
                 → transportᵗ (⊑ᵘ-trans p q) t ≈ᵗ transportᵗ q (transportᵗ p t)
transportᵗ-trans {A} p q (leaf x)             = leaf-≈ (transport-trans A p q x)
transportᵗ-trans p q (op-node op v k kc kn)   = op-≈ (transport-trans ⟦ param op ⟧ᵍ p q v) (λ q' y → ≡→≈ᵗ (cong (λ z → k z y) (⊑-irrelevant _ _)))
transportᵗ-trans p q (delay-node τ k kn)      = delay-≈ (λ q' → ≡→≈ᵗ (cong k (⊑-irrelevant _ _)))
transportᵗ-trans p q (sub e t)                = sub-≈ (transportᵗ-trans p q t)

-- Packaged as a setoid-valued presheaf

Tᵒ : PSh → E → PSh
Tᵒ A ε = record
  { carrier         = Tˢ A ε
  ; _≈_             = _≈ᵗ_
  ; ≈-refl          = λ {w} {t} → ≈ᵗ-refl t
  ; ≈-sym           = ≈ᵗ-sym
  ; ≈-trans         = ≈ᵗ-trans
  ; transport       = transportᵗ
  ; transport-cong  = transportᵗ-cong
  ; transport-refl  = transportᵗ-refl
  ; transport-trans = transportᵗ-trans
  }

-- On-the-nose grade coercion: transport of a tree along an equality of
-- effect grades (used to absorb the propositional monoid laws of `·ₑ`).

-- Moving a sub-effecting node past a grade transport. Both equalities are
-- generalised so they can be matched.

sub-ε-substᵗ : ∀ {A ε₁ ε₁' ε₂ ε₂' w} → (a : ε₁ ≡ ε₁') → (b : ε₂ ≡ ε₂')
             → (q : ε₁ ≾ₑ ε₂) → (q' : ε₁' ≾ₑ ε₂') → (t : Tˢ A ε₁ w)
             → sub q' (ε-substˢ a t) ≈ᵗ ε-substˢ b (sub q t)
sub-ε-substᵗ refl refl q q' t = sub-≈ (≈ᵗ-refl t)

-- FUNCTOR
--
-- The functorial action rebuilds each node's continuation coherence from
-- the mapped continuation, using the map's congruence and naturality.
--
-- `TERMINATING`: the continuations are function-valued and are advanced
-- across the simultaneously-defined `Tˢᶠ-congᵗ`/`Tˢᶠ-natᵗ`, which masks
-- from the termination checker that they act on structurally smaller
-- trees. (Analogously for `μˢ` and `strˢ` below.)

mutual

  {-# TERMINATING #-}

  Tˢᶠ : ∀ {A B ε w} → A →ᵖ B → Tˢ A ε w → Tˢ B ε w
  Tˢᶠ f (leaf x)               = leaf (app f x)
  Tˢᶠ f (op-node op v k kc kn) =
    op-node op v (λ q y → Tˢᶠ f (k q y))
      (λ q e → Tˢᶠ-congᵗ f (kc q e))
      (λ q r y → ≈ᵗ-trans (Tˢᶠ-congᵗ f (kn q r y)) (Tˢᶠ-natᵗ f r (k q y)))
  Tˢᶠ f (delay-node τ k kn) =
    delay-node τ (λ q → Tˢᶠ f (k q))
      (λ q r → ≈ᵗ-trans (Tˢᶠ-congᵗ f (kn q r)) (Tˢᶠ-natᵗ f r (k q)))
  Tˢᶠ f (sub p t)             = sub p (Tˢᶠ f t)

  Tˢᶠ-congᵗ : ∀ {A B ε w} (f : A →ᵖ B) {t t' : Tˢ A ε w} → t ≈ᵗ t' → Tˢᶠ f t ≈ᵗ Tˢᶠ f t'
  Tˢᶠ-congᵗ f (leaf-≈ e)   = leaf-≈ (app-cong f e)
  Tˢᶠ-congᵗ f (op-≈ ev ek) = op-≈ ev (λ q y → Tˢᶠ-congᵗ f (ek q y))
  Tˢᶠ-congᵗ f (delay-≈ ek) = delay-≈ (λ q → Tˢᶠ-congᵗ f (ek q))
  Tˢᶠ-congᵗ f (sub-≈ et)   = sub-≈ (Tˢᶠ-congᵗ f et)
  Tˢᶠ-congᵗ f sub-u        = sub-uᵗ _ _
  Tˢᶠ-congᵗ f sub-∘        = sub-∘ᵗ _ _ _ _
  Tˢᶠ-congᵗ f sub-delay    = sub-delay
  Tˢᶠ-congᵗ f sub-op       = sub-op
  -- the functorial action pushes into the continuations and past the grade
  -- transport, so both delay collapses are reapplied at the mapped tree
  Tˢᶠ-congᵗ f (delay-zero {k = k} {q₀ = q₀} e) =
    ≈ᵗ-trans (delay-zero {q₀ = q₀} e) (≡→≈ᵗ (ε-substˢ-Tˢᶠ' e f (k q₀)))
  Tˢᶠ-congᵗ f (delay-plus {τ₁ = τ₁} {τ₂ = τ₂} {k = k} {kn = kn} hk e) =
    ≈ᵗ-trans (delay-plus (λ q₁ q₂ → Tˢᶠ-congᵗ f (hk q₁ q₂)) e)
             (≡→≈ᵗ (ε-substˢ-Tˢᶠ' e f (delay-node (τ₁ + τ₂) k kn)))
  Tˢᶠ-congᵗ f (≈ᵗ-sym et)  = ≈ᵗ-sym (Tˢᶠ-congᵗ f et)
  Tˢᶠ-congᵗ f (≈ᵗ-trans et et') = ≈ᵗ-trans (Tˢᶠ-congᵗ f et) (Tˢᶠ-congᵗ f et')

  -- The functorial action commutes with a grade transport (needed inside this
  -- block by `Tˢᶠ-congᵗ`; `ε-substˢ-Tˢᶠ` below is the same fact, oriented for
  -- its later uses).

  ε-substˢ-Tˢᶠ' : ∀ {A B ε ε' w} → (p : ε ≡ ε') → (f : A →ᵖ B) → (t : Tˢ A ε w)
                → ε-substˢ p (Tˢᶠ f t) ≡ Tˢᶠ f (ε-substˢ p t)
  ε-substˢ-Tˢᶠ' refl f t = refl

  Tˢᶠ-natᵗ : ∀ {A B ε w w'} (f : A →ᵖ B) (p : w ⊑[ uᵣ ] w') (t : Tˢ A ε w)
           → Tˢᶠ f (transportᵗ p t) ≈ᵗ transportᵗ p (Tˢᶠ f t)
  Tˢᶠ-natᵗ f p (leaf x)               = leaf-≈ (nat f p x)
  Tˢᶠ-natᵗ f p (op-node op v k kc kn) = op-≈ (≈-refl ⟦ param op ⟧ᵍ) (λ q y → ≈ᵗ-refl _)
  Tˢᶠ-natᵗ f p (delay-node τ k kn)    = delay-≈ (λ q → ≈ᵗ-refl _)
  Tˢᶠ-natᵗ f p (sub e t)              = sub-≈ (Tˢᶠ-natᵗ f p t)

Tᶠ : ∀ {A B ε} → A →ᵖ B → Tᵒ A ε →ᵖ Tᵒ B ε
Tᶠ f = pmap (Tˢᶠ f) (Tˢᶠ-congᵗ f) (λ p t → Tˢᶠ-natᵗ f p t)

-- Sub-effecting (the semantics of `coerce`)

T-≤ : ∀ {A ε ε'} → ε ≾ₑ ε' → Tᵒ A ε →ᵖ Tᵒ A ε'
T-≤ p = pmap (sub p) sub-≈ (λ q t → ≈ᵗ-refl _)

-- `Tˢᶠ` is functorial (up to `_≈ᵗ_`)

Tˢᶠ-idᵗ : ∀ {A ε w} (t : Tˢ A ε w) → Tˢᶠ idᵖ t ≈ᵗ t
Tˢᶠ-idᵗ {A} (leaf x)             = leaf-≈ (≈-refl A)
Tˢᶠ-idᵗ (op-node op v k kc kn)   = op-≈ (≈-refl ⟦ param op ⟧ᵍ) (λ q y → Tˢᶠ-idᵗ (k q y))
Tˢᶠ-idᵗ (delay-node τ k kn)      = delay-≈ (λ q → Tˢᶠ-idᵗ (k q))
Tˢᶠ-idᵗ (sub p t)               = sub-≈ (Tˢᶠ-idᵗ t)

Tᶠ-id : ∀ {A ε} → Tᶠ {A} {A} {ε} idᵖ ≈ᵖ idᵖ
Tᶠ-id t = Tˢᶠ-idᵗ t

Tˢᶠ-∘ᵗ : ∀ {A B C ε w} (g : B →ᵖ C) (f : A →ᵖ B) (t : Tˢ A ε w)
       → Tˢᶠ (g ∘ᵖ f) t ≈ᵗ Tˢᶠ g (Tˢᶠ f t)
Tˢᶠ-∘ᵗ {C = C} g f (leaf x)             = leaf-≈ (≈-refl C)
Tˢᶠ-∘ᵗ g f (op-node op v k kc kn)       = op-≈ (≈-refl ⟦ param op ⟧ᵍ) (λ q y → Tˢᶠ-∘ᵗ g f (k q y))
Tˢᶠ-∘ᵗ g f (delay-node τ k kn)          = delay-≈ (λ q → Tˢᶠ-∘ᵗ g f (k q))
Tˢᶠ-∘ᵗ g f (sub p t)                    = sub-≈ (Tˢᶠ-∘ᵗ g f t)

Tᶠ-∘ : ∀ {A B C ε} (g : B →ᵖ C) (f : A →ᵖ B)
     → Tᶠ {A} {C} {ε} (g ∘ᵖ f) ≈ᵖ Tᶠ g ∘ᵖ Tᶠ f
Tᶠ-∘ g f t = Tˢᶠ-∘ᵗ g f t

Tˢᶠ-cong-fg : ∀ {A B ε w} {f g : A →ᵖ B} → f ≈ᵖ g → (t : Tˢ A ε w) → Tˢᶠ f t ≈ᵗ Tˢᶠ g t
Tˢᶠ-cong-fg e (leaf x)             = leaf-≈ (e x)
Tˢᶠ-cong-fg e (op-node op v k kc kn) = op-≈ (≈-refl ⟦ param op ⟧ᵍ) (λ q y → Tˢᶠ-cong-fg e (k q y))
Tˢᶠ-cong-fg e (delay-node τ k kn)  = delay-≈ (λ q → Tˢᶠ-cong-fg e (k q))
Tˢᶠ-cong-fg e (sub p t)            = sub-≈ (Tˢᶠ-cong-fg e t)

T-congᶠ : ∀ {A B ε} {f g : A →ᵖ B} → f ≈ᵖ g → Tᶠ {A} {B} {ε} f ≈ᵖ Tᶠ g
T-congᶠ e t = Tˢᶠ-cong-fg e t

-- T-≤ (sub-effecting) is natural (on the nose)

T-≤-nat : ∀ {A B ε ε'} → (f : A →ᵖ B) → (p : ε ≾ₑ ε')
        → Tᶠ f ∘ᵖ T-≤ p ≈ᵖ T-≤ p ∘ᵖ Tᶠ f
T-≤-nat f p t = ≈ᵗ-refl _

-- `ε-substˢ` commutes with the functorial action

ε-substˢ-Tˢᶠ : ∀ {A B ε ε' w} → (p : ε ≡ ε') → (f : A →ᵖ B) → (t : Tˢ A ε w)
             → ε-substˢ p (Tˢᶠ f t) ≡ Tˢᶠ f (ε-substˢ p t)
ε-substˢ-Tˢᶠ refl f t = refl

-- UNIT

ηᵀ : ∀ {A} → A →ᵖ Tᵒ A uₑ
ηᵀ = pmap leaf leaf-≈ (λ p x → ≈ᵗ-refl _)

ηᵀ-nat : ∀ {A B} → (f : A →ᵖ B) → ηᵀ ∘ᵖ f ≈ᵖ Tᶠ f ∘ᵖ ηᵀ
ηᵀ-nat f x = ≈ᵗ-refl _

ε-substˢ-delay : ∀ {A ε ε' w} → (τ : ℕ) → (p : ε ≡ ε')
               → (k : ∀ {w'} → w ⊑[ mapᵉ (of-natᵉ τ) ] w' → Tˢ A ε w')
               → (kn : ∀ {w' w''} (q : w ⊑[ mapᵉ (of-natᵉ τ) ] w') (r : w' ⊑[ uᵣ ] w'')
                     → k (⊑ρ∘ᵘ q r) ≈ᵗ transportᵗ r (k q))
               → ε-substˢ (cong (of-natᵉ τ ·ₑ_) p) (delay-node τ k kn)
               ≈ᵗ delay-node τ (λ q → ε-substˢ p (k q))
                    (λ q r → ≈ᵗ-trans (ε-substˢ-congᵗ p (kn q r))
                                      (≡→≈ᵗ (sym (transportᵗ-ε-substˢ r p (k q)))))
ε-substˢ-delay τ refl k kn = delay-≈ (λ q → ≈ᵗ-refl _)

-- Any two transports along equal grades agree (UIP), and a transport under a
-- delay node may be pulled out to the whole node. Both are stated with the
-- coherence witnesses explicit, since they are never inferable from the goal.

ε-substˢ-uip : ∀ {A ε ε' w} → (p q : ε ≡ ε') → (t : Tˢ A ε w)
             → ε-substˢ p t ≡ ε-substˢ q t
ε-substˢ-uip p q t = cong (λ z → ε-substˢ z t) (uip {p = p} {q = q})

delay-ε-substˢ-out : ∀ {A ε ε' w} → (τ : ℕ) → (p : ε ≡ ε')
                   → (k : ∀ {w'} → w ⊑[ mapᵉ (of-natᵉ τ) ] w' → Tˢ A ε w')
                   → (kn : ∀ {w' w''} (q : w ⊑[ mapᵉ (of-natᵉ τ) ] w') (r : w' ⊑[ uᵣ ] w'')
                         → k (⊑ρ∘ᵘ q r) ≈ᵗ transportᵗ r (k q))
                   → (kn' : ∀ {w' w''} (q : w ⊑[ mapᵉ (of-natᵉ τ) ] w') (r : w' ⊑[ uᵣ ] w'')
                          → ε-substˢ p (k (⊑ρ∘ᵘ q r)) ≈ᵗ transportᵗ r (ε-substˢ p (k q)))
                   → delay-node τ (λ q → ε-substˢ p (k q)) kn'
                   ≈ᵗ ε-substˢ (cong (of-natᵉ τ ·ₑ_) p) (delay-node τ k kn)
delay-ε-substˢ-out τ refl k kn kn' = delay-irrᵗ k kn' kn

-- `delay-plus` when the inner node sits under a grade transport — the shape
-- the structural recursions (`μˢ`, `strˢ`, the handler fold) produce, since
-- each regrades the node it rebuilds. Everything is explicit, so the rule
-- applies to a goal without inferring coherence witnesses.

delay-plus-out :
  ∀ {A ε ε₂ w} {τ₁ τ₂ : ℕ}
  → (p : of-natᵉ τ₂ ·ₑ ε ≡ ε₂)
  → (k' : ∀ {w'} → w ⊑[ mapᵉ (of-natᵉ τ₁) ] w'
        → ∀ {w''} → w' ⊑[ mapᵉ (of-natᵉ τ₂) ] w'' → Tˢ A ε w'')
  → (kn₂ : ∀ {w'} (q₁ : w ⊑[ mapᵉ (of-natᵉ τ₁) ] w')
         → ∀ {w'' w'''} (q₂ : w' ⊑[ mapᵉ (of-natᵉ τ₂) ] w'') (r : w'' ⊑[ uᵣ ] w''')
         → k' q₁ (⊑ρ∘ᵘ q₂ r) ≈ᵗ transportᵗ r (k' q₁ q₂))
  → (kn₁ : ∀ {w' w''} (q₁ : w ⊑[ mapᵉ (of-natᵉ τ₁) ] w') (r : w' ⊑[ uᵣ ] w'')
         → ε-substˢ p (delay-node τ₂ (k' (⊑ρ∘ᵘ q₁ r)) (kn₂ (⊑ρ∘ᵘ q₁ r)))
         ≈ᵗ transportᵗ r (ε-substˢ p (delay-node τ₂ (k' q₁) (kn₂ q₁))))
  → (k : ∀ {w'} → w ⊑[ mapᵉ (of-natᵉ (τ₁ + τ₂)) ] w' → Tˢ A ε w')
  → (kn : ∀ {w' w''} (q : w ⊑[ mapᵉ (of-natᵉ (τ₁ + τ₂)) ] w') (r : w' ⊑[ uᵣ ] w'')
        → k (⊑ρ∘ᵘ q r) ≈ᵗ transportᵗ r (k q))
  → (∀ {w' w''} (q₁ : w ⊑[ mapᵉ (of-natᵉ τ₁) ] w') (q₂ : w' ⊑[ mapᵉ (of-natᵉ τ₂) ] w'')
     → k' q₁ q₂ ≈ᵗ k (⊑-split q₁ q₂))
  → delay-node τ₁ (λ q₁ → ε-substˢ p (delay-node τ₂ (k' q₁) (kn₂ q₁))) kn₁
  ≈ᵗ ε-substˢ (trans delay+ᵉ (cong (of-natᵉ τ₁ ·ₑ_) p)) (delay-node (τ₁ + τ₂) k kn)
delay-plus-out refl k' kn₂ kn₁ k kn hk =
  ≈ᵗ-trans (delay-plus hk delay+ᵉ)
           (≡→≈ᵗ (ε-substˢ-uip delay+ᵉ (trans delay+ᵉ refl) (delay-node _ k kn)))

-- MULTIPLICATION

mutual

  {-# TERMINATING #-}

  μˢ : ∀ {A ε ε' w} → Tˢ (Tᵒ A ε') ε w → Tˢ A (ε ·ₑ ε') w
  μˢ {ε' = ε'} (leaf t) =
    ε-substˢ (sym (·ₑ-identityˡ ε')) t
  μˢ {ε' = ε'} (op-node {ε = ε₀} op v k kc kn) =
    ε-substˢ (sym (·ₑ-assoc (op-grade op) ε₀ ε'))
      (op-node op v (λ q y → μˢ (k q y))
        (λ q e → μˢ-congᵗ (kc q e))
        (λ q r y → ≈ᵗ-trans (μˢ-congᵗ (kn q r y)) (μˢ-natᵗ r (k q y))))
  μˢ {ε' = ε'} (delay-node {ε = ε₀} τ k kn) =
    ε-substˢ (sym (·ₑ-assoc (of-natᵉ τ) ε₀ ε'))
      (delay-node τ (λ q → μˢ (k q))
        (λ q r → ≈ᵗ-trans (μˢ-congᵗ (kn q r)) (μˢ-natᵗ r (k q))))
  μˢ (sub p t) =
    sub (·ₑ-monoˡ-≾ₑ p) (μˢ t)

  -- `μˢ` commutes with a grade transport (needed inside this block by
  -- `μˢ-congᵗ`; `ε-substˢ-μˢ` below is the same fact, named for its later uses).

  ε-substˢ-μˢ' : ∀ {A ε ε₁ δ w} → (p : ε ≡ ε₁) → (t : Tˢ (Tᵒ A δ) ε w)
               → μˢ (ε-substˢ p t) ≡ ε-substˢ (cong (_·ₑ δ) p) (μˢ t)
  ε-substˢ-μˢ' refl t = refl

  μˢ-congᵗ : ∀ {A ε ε' w} {t t' : Tˢ (Tᵒ A ε') ε w} → t ≈ᵗ t' → μˢ t ≈ᵗ μˢ t'
  μˢ-congᵗ (leaf-≈ e)   = ε-substˢ-congᵗ _ e
  μˢ-congᵗ (op-≈ ev ek) = ε-substˢ-congᵗ _ (op-≈ ev (λ q y → μˢ-congᵗ (ek q y)))
  μˢ-congᵗ (delay-≈ ek) = ε-substˢ-congᵗ _ (delay-≈ (λ q → μˢ-congᵗ (ek q)))
  μˢ-congᵗ (sub-≈ et)   = sub-≈ (μˢ-congᵗ et)
  μˢ-congᵗ sub-u        = sub-uᵗ _ _
  μˢ-congᵗ sub-∘        = sub-∘ᵗ _ _ _ _
  -- the coercion moves past `μˢ`'s grade transport, and then under the delay
  μˢ-congᵗ {ε' = ε'} (sub-delay {ε = ε₁} {ε' = ε₁'} {τ = τ} {e = e}) =
    ≈ᵗ-trans
      (sub-ε-substᵗ (sym (·ₑ-assoc (of-natᵉ τ) ε₁ ε'))
                    (sym (·ₑ-assoc (of-natᵉ τ) ε₁' ε'))
                    (·ₑ-monoʳ-≾ₑ (·ₑ-monoˡ-≾ₑ e))
                    (·ₑ-monoˡ-≾ₑ (·ₑ-monoʳ-≾ₑ e))
                    _)
      (ε-substˢ-congᵗ _ sub-delay)
  -- likewise under an operation
  μˢ-congᵗ {ε' = ε'} (sub-op {ε = ε₁} {ε' = ε₁'} {op = op} {e = e}) =
    ≈ᵗ-trans
      (sub-ε-substᵗ (sym (·ₑ-assoc (op-grade op) ε₁ ε'))
                    (sym (·ₑ-assoc (op-grade op) ε₁' ε'))
                    (·ₑ-monoʳ-≾ₑ (·ₑ-monoˡ-≾ₑ e))
                    (·ₑ-monoˡ-≾ₑ (·ₑ-monoʳ-≾ₑ e))
                    _)
      (ε-substˢ-congᵗ _ sub-op)
  -- `μˢ` regrades a delay node but leaves the node itself, so both collapses
  -- are reapplied to the folded continuations; the regradings are reconciled
  -- by UIP (all proofs of a grade equality agree)
  μˢ-congᵗ {ε' = ε'} (delay-zero {ε = ε₀} {k = k} {q₀ = q₀} e) =
    ≈ᵗ-trans (ε-substˢ-congᵗ a₁ (delay-zero {q₀ = q₀} delay0ᵉ))
             (≡→≈ᵗ (trans (ε-substˢ-trans delay0ᵉ a₁ (μˢ (k q₀)))
                   (trans (ε-substˢ-uip (trans delay0ᵉ a₁) (cong (_·ₑ ε') e) (μˢ (k q₀)))
                          (sym (ε-substˢ-μˢ' e (k q₀))))))
    where
      a₁ = sym (·ₑ-assoc (of-natᵉ 0) ε₀ ε')
  μˢ-congᵗ {ε' = ε'} (delay-plus {ε = ε₀} {τ₁ = τ₁} {τ₂ = τ₂} {k = k} {kn = kn}
                                 {k' = k'} hk e) =
    ≈ᵗ-trans (ε-substˢ-congᵗ a₁
               (delay-plus-out a₂ (λ q₁ q₂ → μˢ (k' q₁ q₂)) _ _ (λ q → μˢ (k q)) _
                  (λ q₁ q₂ → μˢ-congᵗ (hk q₁ q₂))))
              (≡→≈ᵗ (trans (ε-substˢ-trans (trans delay+ᵉ b₂) a₁ D)
                    (trans (ε-substˢ-uip (trans (trans delay+ᵉ b₂) a₁)
                                         (trans a₃ (cong (_·ₑ ε') e)) D)
                    (trans (sym (ε-substˢ-trans a₃ (cong (_·ₑ ε') e) D))
                           (sym (ε-substˢ-μˢ' e (delay-node (τ₁ + τ₂) k kn)))))))
    where
      a₁ = sym (·ₑ-assoc (of-natᵉ τ₁) (of-natᵉ τ₂ ·ₑ ε₀) ε')
      a₂ = sym (·ₑ-assoc (of-natᵉ τ₂) ε₀ ε')
      a₃ = sym (·ₑ-assoc (of-natᵉ (τ₁ + τ₂)) ε₀ ε')
      b₂ = cong (of-natᵉ τ₁ ·ₑ_) a₂
      D  = delay-node (τ₁ + τ₂) (λ q → μˢ (k q))
             (λ q r → ≈ᵗ-trans (μˢ-congᵗ (kn q r)) (μˢ-natᵗ r (k q)))
  μˢ-congᵗ (≈ᵗ-sym et)  = ≈ᵗ-sym (μˢ-congᵗ et)
  μˢ-congᵗ (≈ᵗ-trans et et') = ≈ᵗ-trans (μˢ-congᵗ et) (μˢ-congᵗ et')

  μˢ-natᵗ : ∀ {A ε ε' w w'} (p : w ⊑[ uᵣ ] w') (t : Tˢ (Tᵒ A ε') ε w)
          → μˢ (transportᵗ p t) ≈ᵗ transportᵗ p (μˢ t)
  μˢ-natᵗ p (leaf t) =
    ≡→≈ᵗ (sym (transportᵗ-ε-substˢ p (sym (·ₑ-identityˡ _)) t))
  μˢ-natᵗ p (op-node op v k kc kn) =
    ≈ᵗ-trans
      (ε-substˢ-congᵗ (sym (·ₑ-assoc _ _ _)) (op-≈ (≈-refl ⟦ param op ⟧ᵍ) (λ q y → ≈ᵗ-refl _)))
      (≡→≈ᵗ (sym (transportᵗ-ε-substˢ p (sym (·ₑ-assoc _ _ _)) _)))
  μˢ-natᵗ p (delay-node τ k kn) =
    ≈ᵗ-trans
      (ε-substˢ-congᵗ (sym (·ₑ-assoc _ _ _)) (delay-≈ (λ q → ≈ᵗ-refl _)))
      (≡→≈ᵗ (sym (transportᵗ-ε-substˢ p (sym (·ₑ-assoc _ _ _)) _)))
  μˢ-natᵗ p (sub e t) =
    sub-≈ (μˢ-natᵗ p t)

μᵀ : ∀ {A ε ε'} → Tᵒ (Tᵒ A ε') ε →ᵖ Tᵒ A (ε ·ₑ ε')
μᵀ = pmap μˢ μˢ-congᵗ (λ p t → μˢ-natᵗ p t)

-- On-the-nose grade coercion at the presheaf level

ε-substᵀ : ∀ {A ε ε'} → ε ≡ ε' → Tᵒ A ε →ᵖ Tᵒ A ε'
ε-substᵀ p = pmap (ε-substˢ p) (ε-substˢ-congᵗ p) (λ q t → ≡→≈ᵗ (sym (transportᵗ-ε-substˢ q p t)))

ε-substᵀ-refl : ∀ {A ε} → ε-substᵀ {A} {ε} refl ≈ᵖ idᵖ
ε-substᵀ-refl t = ≈ᵗ-refl _

ε-substᵀ-trans : ∀ {A ε ε' ε''} → (p : ε ≡ ε') → (q : ε' ≡ ε'')
               → ε-substᵀ q ∘ᵖ ε-substᵀ p ≈ᵖ ε-substᵀ {A} (trans p q)
ε-substᵀ-trans p q t = ≡→≈ᵗ (ε-substˢ-trans p q t)

-- `ε-substˢ` pushes through the operation and delay nodes (up to `_≈ᵗ_`,
-- since the pushed continuation carries rebuilt coherence witnesses).

ε-substˢ-op : ∀ {A ε ε' w} → (p : ε ≡ ε') → (op : Op) → (v : carrier ⟦ param op ⟧ᵍ w)
            → (k : ∀ {w'} → w ⊑[ mapᵉ (op-grade op) ] w' → carrier ⟦ arity op ⟧ᵍ w' → Tˢ A ε w')
            → (kc : ∀ {w'} (q : w ⊑[ mapᵉ (op-grade op) ] w') {y y' : carrier ⟦ arity op ⟧ᵍ w'}
                  → _≈_ ⟦ arity op ⟧ᵍ y y' → k q y ≈ᵗ k q y')
            → (kn : ∀ {w' w''} (q : w ⊑[ mapᵉ (op-grade op) ] w') (r : w' ⊑[ uᵣ ] w'')
                      (y : carrier ⟦ arity op ⟧ᵍ w')
                  → k (⊑ρ∘ᵘ q r) (transport ⟦ arity op ⟧ᵍ r y) ≈ᵗ transportᵗ r (k q y))
            → ε-substˢ (cong (op-grade op ·ₑ_) p) (op-node op v k kc kn)
            ≈ᵗ op-node op v (λ q y → ε-substˢ p (k q y))
                 (λ q e → ε-substˢ-congᵗ p (kc q e))
                 (λ q r y → ≈ᵗ-trans (ε-substˢ-congᵗ p (kn q r y))
                                     (≡→≈ᵗ (sym (transportᵗ-ε-substˢ r p (k q y)))))
ε-substˢ-op refl op v k kc kn = op-≈ (≈-refl ⟦ param op ⟧ᵍ) (λ q y → ≈ᵗ-refl _)

-- `ε-substˢ` commutes with multiplication (on the outer grade)

ε-substˢ-μˢ : ∀ {A ε ε₁ δ w} → (p : ε ≡ ε₁) → (t : Tˢ (Tᵒ A δ) ε w)
            → μˢ (ε-substˢ p t) ≡ ε-substˢ (cong (_·ₑ δ) p) (μˢ t)
ε-substˢ-μˢ = ε-substˢ-μˢ'

-- `ε-substˢ` commutes with the sub-effecting node (on either side)

sub-substˢ : ∀ {A ε₀ ε₁ ε₂ w} → (P : ε₁ ≾ₑ ε₂) → (r : ε₀ ≡ ε₁) → (t : Tˢ A ε₀ w)
           → sub P (ε-substˢ r t) ≡ sub (subst (_≾ₑ ε₂) (sym r) P) t
sub-substˢ P refl t = refl

ε-substˢ-sub : ∀ {A ε₁ ε₂ ε₃ w} → (P : ε₁ ≾ₑ ε₂) → (r : ε₂ ≡ ε₃) → (t : Tˢ A ε₁ w)
             → ε-substˢ r (sub P t) ≡ sub (subst (ε₁ ≾ₑ_) r P) t
ε-substˢ-sub P refl t = refl

-- Multiplication is natural in the value functor: `μˢ` commutes with
-- `Tˢᶠ f` (which acts on the inner monad layer via `Tᶠ f`). At each node
-- the equation recurses into the continuation and absorbs the grade
-- coercion with `ε-substˢ-Tˢᶠ`.

μˢ-nat-f : ∀ {A B ε ε' w} (f : A →ᵖ B) (t : Tˢ (Tᵒ A ε') ε w)
         → μˢ (Tˢᶠ (Tᶠ f) t) ≈ᵗ Tˢᶠ f (μˢ t)
μˢ-nat-f f (leaf s) =
  ≡→≈ᵗ (ε-substˢ-Tˢᶠ (sym (·ₑ-identityˡ _)) f s)
μˢ-nat-f f (op-node op v k kc kn) =
  ≈ᵗ-trans
    (ε-substˢ-congᵗ (sym (·ₑ-assoc _ _ _))
      (op-≈ (≈-refl ⟦ param op ⟧ᵍ) (λ q y → μˢ-nat-f f (k q y))))
    (≡→≈ᵗ (ε-substˢ-Tˢᶠ (sym (·ₑ-assoc _ _ _)) f _))
μˢ-nat-f f (delay-node τ k kn) =
  ≈ᵗ-trans
    (ε-substˢ-congᵗ (sym (·ₑ-assoc _ _ _))
      (delay-≈ (λ q → μˢ-nat-f f (k q))))
    (≡→≈ᵗ (ε-substˢ-Tˢᶠ (sym (·ₑ-assoc _ _ _)) f _))
μˢ-nat-f f (sub p t) =
  sub-≈ (μˢ-nat-f f t)

μᵀ-nat : ∀ {A B ε ε'} → (f : A →ᵖ B)
       → μᵀ {ε = ε} {ε' = ε'} ∘ᵖ Tᶠ (Tᶠ f) ≈ᵖ Tᶠ f ∘ᵖ μᵀ
μᵀ-nat f t = μˢ-nat-f f t

-- MONAD LAWS

-- First identity law

T-μ∘η≡id : ∀ {A ε} → μᵀ {A} {uₑ} {ε} ∘ᵖ ηᵀ {Tᵒ A ε} ≈ᵖ ε-substᵀ (sym (·ₑ-identityˡ ε))
T-μ∘η≡id t = ≈ᵗ-refl _

-- Second identity law

μˢ-identity₂ : ∀ {A ε w} → (t : Tˢ A ε w)
             → μˢ (Tˢᶠ ηᵀ t) ≈ᵗ ε-substˢ (sym (·ₑ-identityʳ ε)) t
μˢ-identity₂ (leaf x) =
  ≡→≈ᵗ (cong (λ p → ε-substˢ p (leaf x)) uip)
μˢ-identity₂ (op-node {ε = ε₀} op v k kc kn) =
  ≈ᵗ-trans
    (ε-substˢ-congᵗ (sym (·ₑ-assoc (op-grade op) ε₀ uₑ))
      (≈ᵗ-trans
        (op-≈ (≈-refl ⟦ param op ⟧ᵍ) (λ q y → μˢ-identity₂ (k q y)))
        (≈ᵗ-sym (ε-substˢ-op (sym (·ₑ-identityʳ ε₀)) op v k kc kn))))
    (≡→≈ᵗ
      (trans
        (ε-substˢ-trans (cong (op-grade op ·ₑ_) (sym (·ₑ-identityʳ ε₀)))
          (sym (·ₑ-assoc (op-grade op) ε₀ uₑ)) (op-node op v k kc kn))
        (cong (λ p → ε-substˢ p (op-node op v k kc kn)) uip)))
μˢ-identity₂ (delay-node {ε = ε₀} τ k kn) =
  ≈ᵗ-trans
    (ε-substˢ-congᵗ (sym (·ₑ-assoc (of-natᵉ τ) ε₀ uₑ))
      (≈ᵗ-trans
        (delay-≈ (λ q → μˢ-identity₂ (k q)))
        (≈ᵗ-sym (ε-substˢ-delay τ (sym (·ₑ-identityʳ ε₀)) k kn))))
    (≡→≈ᵗ
      (trans
        (ε-substˢ-trans (cong (of-natᵉ τ ·ₑ_) (sym (·ₑ-identityʳ ε₀)))
          (sym (·ₑ-assoc (of-natᵉ τ) ε₀ uₑ)) (delay-node τ k kn))
        (cong (λ p → ε-substˢ p (delay-node τ k kn)) uip)))
μˢ-identity₂ (sub p t) =
  ≈ᵗ-trans
    (sub-≈ (μˢ-identity₂ t))
    (≡→≈ᵗ
      (trans (sub-substˢ (·ₑ-monoˡ-≾ₑ p) (sym (·ₑ-identityʳ _)) t)
        (trans (cong (λ P → sub P t) (≾ₑ-irrelevant _ _))
               (sym (ε-substˢ-sub p (sym (·ₑ-identityʳ _)) t)))))

T-μ∘Tη≡id : ∀ {A ε} → μᵀ {A} {ε} {uₑ} ∘ᵖ Tᶠ (ηᵀ {A}) ≈ᵖ ε-substᵀ (sym (·ₑ-identityʳ ε))
T-μ∘Tη≡id t = μˢ-identity₂ t

-- Associativity law

μˢ-assoc : ∀ {A ε ε' ε'' w} → (t : Tˢ (Tᵒ (Tᵒ A ε'') ε') ε w)
         → μˢ {ε = ε} {ε' = ε' ·ₑ ε''} (Tˢᶠ (μᵀ {A} {ε'} {ε''}) t)
         ≈ᵗ ε-substˢ (·ₑ-assoc ε ε' ε'') (μˢ (μˢ t))
μˢ-assoc {ε' = ε'} {ε'' = ε''} (leaf s) =
  ≡→≈ᵗ (sym
    (trans
      (cong (ε-substˢ (·ₑ-assoc uₑ ε' ε'')) (ε-substˢ-μˢ (sym (·ₑ-identityˡ ε')) s))
      (trans
        (ε-substˢ-trans (cong (_·ₑ ε'') (sym (·ₑ-identityˡ ε'))) (·ₑ-assoc uₑ ε' ε'') (μˢ s))
        (cong (λ p → ε-substˢ p (μˢ s)) uip))))
μˢ-assoc {ε' = ε'} {ε'' = ε''} (op-node {ε = ε₀} op v k kc kn) =
  ≈ᵗ-trans
    (ε-substˢ-congᵗ (sym (·ₑ-assoc (op-grade op) ε₀ (ε' ·ₑ ε'')))
      (≈ᵗ-trans
        (op-≈ (≈-refl ⟦ param op ⟧ᵍ) (λ q y → μˢ-assoc (k q y)))
        (≈ᵗ-sym (ε-substˢ-op (·ₑ-assoc ε₀ ε' ε'') op v (λ q y → μˢ (μˢ (k q y))) _ _))))
    (≡→≈ᵗ
      (trans
        (ε-substˢ-trans (cong (op-grade op ·ₑ_) (·ₑ-assoc ε₀ ε' ε''))
          (sym (·ₑ-assoc (op-grade op) ε₀ (ε' ·ₑ ε''))) BASE)
      (trans
        (cong (λ p → ε-substˢ p BASE) uip)
        (sym
          (trans
            (cong (ε-substˢ (·ₑ-assoc (op-grade op ·ₑ ε₀) ε' ε''))
              (trans
                (ε-substˢ-μˢ (sym (·ₑ-assoc (op-grade op) ε₀ ε')) BASE1)
                (ε-substˢ-trans (sym (·ₑ-assoc (op-grade op) (ε₀ ·ₑ ε') ε''))
                  (cong (_·ₑ ε'') (sym (·ₑ-assoc (op-grade op) ε₀ ε'))) BASE)))
            (ε-substˢ-trans
              (trans (sym (·ₑ-assoc (op-grade op) (ε₀ ·ₑ ε') ε''))
                (cong (_·ₑ ε'') (sym (·ₑ-assoc (op-grade op) ε₀ ε'))))
              (·ₑ-assoc (op-grade op ·ₑ ε₀) ε' ε'') BASE))))))
  where
    BASE1 = op-node op v (λ q y → μˢ (k q y))
              (λ q e → μˢ-congᵗ (kc q e))
              (λ q r y → ≈ᵗ-trans (μˢ-congᵗ (kn q r y)) (μˢ-natᵗ r (k q y)))
    BASE = op-node op v (λ q y → μˢ (μˢ (k q y)))
             (λ q e → μˢ-congᵗ (μˢ-congᵗ (kc q e)))
             (λ q r y → ≈ᵗ-trans (μˢ-congᵗ (≈ᵗ-trans (μˢ-congᵗ (kn q r y)) (μˢ-natᵗ r (k q y))))
                                 (μˢ-natᵗ r (μˢ (k q y))))
μˢ-assoc {ε' = ε'} {ε'' = ε''} (delay-node {ε = ε₀} τ k kn) =
  ≈ᵗ-trans
    (ε-substˢ-congᵗ (sym (·ₑ-assoc (of-natᵉ τ) ε₀ (ε' ·ₑ ε'')))
      (≈ᵗ-trans
        (delay-≈ (λ q → μˢ-assoc (k q)))
        (≈ᵗ-sym (ε-substˢ-delay τ (·ₑ-assoc ε₀ ε' ε'') (λ q → μˢ (μˢ (k q))) _))))
    (≡→≈ᵗ
      (trans
        (ε-substˢ-trans (cong (of-natᵉ τ ·ₑ_) (·ₑ-assoc ε₀ ε' ε''))
          (sym (·ₑ-assoc (of-natᵉ τ) ε₀ (ε' ·ₑ ε''))) DBASE)
      (trans
        (cong (λ p → ε-substˢ p DBASE) uip)
        (sym
          (trans
            (cong (ε-substˢ (·ₑ-assoc (of-natᵉ τ ·ₑ ε₀) ε' ε''))
              (trans
                (ε-substˢ-μˢ (sym (·ₑ-assoc (of-natᵉ τ) ε₀ ε')) DBASE1)
                (ε-substˢ-trans (sym (·ₑ-assoc (of-natᵉ τ) (ε₀ ·ₑ ε') ε''))
                  (cong (_·ₑ ε'') (sym (·ₑ-assoc (of-natᵉ τ) ε₀ ε'))) DBASE)))
            (ε-substˢ-trans
              (trans (sym (·ₑ-assoc (of-natᵉ τ) (ε₀ ·ₑ ε') ε''))
                (cong (_·ₑ ε'') (sym (·ₑ-assoc (of-natᵉ τ) ε₀ ε'))))
              (·ₑ-assoc (of-natᵉ τ ·ₑ ε₀) ε' ε'') DBASE))))))
  where
    DBASE1 = delay-node τ (λ q → μˢ (k q))
               (λ q r → ≈ᵗ-trans (μˢ-congᵗ (kn q r)) (μˢ-natᵗ r (k q)))
    DBASE = delay-node τ (λ q → μˢ (μˢ (k q)))
              (λ q r → ≈ᵗ-trans (μˢ-congᵗ (≈ᵗ-trans (μˢ-congᵗ (kn q r)) (μˢ-natᵗ r (k q))))
                                (μˢ-natᵗ r (μˢ (k q))))
μˢ-assoc {ε' = ε'} {ε'' = ε''} (sub p t) =
  ≈ᵗ-trans (sub-≈ (μˢ-assoc t))
    (≡→≈ᵗ (trans (sub-substˢ (·ₑ-monoˡ-≾ₑ p) (·ₑ-assoc _ ε' ε'') (μˢ (μˢ t)))
      (trans (cong (λ P → sub P (μˢ (μˢ t))) (≾ₑ-irrelevant _ _))
             (sym (ε-substˢ-sub (·ₑ-monoˡ-≾ₑ (·ₑ-monoˡ-≾ₑ p)) (·ₑ-assoc _ ε' ε'') (μˢ (μˢ t)))))))

T-μ∘μ≡μ∘Tμ : ∀ {A ε ε' ε''}
           → μᵀ {A} {ε} {ε' ·ₑ ε''} ∘ᵖ Tᶠ (μᵀ {A} {ε'} {ε''})
           ≈ᵖ ε-substᵀ (·ₑ-assoc ε ε' ε'') ∘ᵖ μᵀ ∘ᵖ μᵀ
T-μ∘μ≡μ∘Tμ t = μˢ-assoc t

-- STRENGTH
--
-- The strength threads a box `[ mapᵉ ε ]ᶜ A` along the tree. The box is
-- kept as a *bundle* (carrying its own naturality `fun-nat`), which is
-- what lets the strengthened tree's nodes rebuild their coherence
-- witnesses. The box presheaf `A` is kept explicit throughout (it can
-- never be recovered from the non-injective box carrier).

-- Coercion of a resource-accessibility witness along an equality of grades.

⊑-coe : ∀ {ρ ρ' w w'} → ρ ≡ ρ' → w ⊑[ ρ ] w' → w ⊑[ ρ' ] w'
⊑-coe e = ⊑-mono (≾ᵣ-reflexive e)

-- Advance a box across a resource step (used when recursing under a node).

box▸ : ∀ {ρ₀ ε₀ w w'} (A : PSh) → w ⊑[ mapᵉ ρ₀ ] w' → [ mapᵉ (ρ₀ ·ₑ ε₀) ]ᶜ A w → [ mapᵉ ε₀ ]ᶜ A w'
box▸ A q box = mk[]
  (λ r → fun box (⊑-coe (sym map-·ᵉ) (⊑-trans q r)))
  (λ r s → ≈-trans A ([]-fun-irr box _ _) (fun-nat box (⊑-coe (sym map-·ᵉ) (⊑-trans q r)) s))

mutual

  {-# TERMINATING #-}

  strˢ : ∀ {B ε w} (A : PSh) → [ mapᵉ ε ]ᶜ A w → Tˢ B ε w → Tˢ (A ×ᵖ B) ε w
  strˢ A box (leaf b) =
    leaf (fun box (⊑-coe (sym map-uᵉ) ⊑-refl) , b)
  strˢ A box (op-node op v k kc kn) =
    op-node op v (λ q y → strˢ A (box▸ A q box) (k q y))
      (λ q e → strˢ-congᵗ A (λ r → ≈-refl A) (kc q e))
      (λ q r y → ≈ᵗ-trans
        (strˢ-congᵗ A (λ t → []-fun-irr box _ _) (kn q r y))
        (strˢ-natᵗ A (box▸ A q box) r (k q y)))
  strˢ A box (delay-node τ k kn) =
    delay-node τ (λ q → strˢ A (box▸ A q box) (k q))
      (λ q r → ≈ᵗ-trans
        (strˢ-congᵗ A (λ t → []-fun-irr box _ _) (kn q r))
        (strˢ-natᵗ A (box▸ A q box) r (k q)))
  strˢ A box (sub p t) =
    sub p (strˢ A (app ([]-≤ (map-monotoneᵉ p)) box) t)

  -- Strength respects `_≈ᵗ_` in both the box (pointwise `_≈_`) and the tree

  -- `ε-substˢ` commutes with the strength (coercing the box's grade)

  strˢ-ε-substˢ : ∀ {B ε ε₁ w} (A : PSh) → (p : ε ≡ ε₁)
                → (a : [ mapᵉ ε₁ ]ᶜ A w)
                → (t : Tˢ B ε w)
                → strˢ A a (ε-substˢ p t)
                ≈ᵗ ε-substˢ p (strˢ A (app ([]-≤ (≾ᵣ-reflexive (cong mapᵉ p))) a) t)
  strˢ-ε-substˢ A refl a t = strˢ-congᵗ A (λ r → []-fun-irr a _ _) (≈ᵗ-refl t)

  strˢ-congᵗ : ∀ {B ε w} (A : PSh) {box box' : [ mapᵉ ε ]ᶜ A w}
             → (∀ {w'} (r : w ⊑[ mapᵉ ε ] w') → _≈_ A (fun box r) (fun box' r))
             → {t t' : Tˢ B ε w} → t ≈ᵗ t' → strˢ A box t ≈ᵗ strˢ A box' t'
  strˢ-congᵗ A hb (leaf-≈ eb)  = leaf-≈ (hb _ , eb)
  strˢ-congᵗ A hb (op-≈ ev ek) = op-≈ ev (λ q y → strˢ-congᵗ A (λ r → hb _) (ek q y))
  strˢ-congᵗ A hb (delay-≈ ek) = delay-≈ (λ q → strˢ-congᵗ A (λ r → hb _) (ek q))
  strˢ-congᵗ A hb (sub-≈ {e = e} {e' = e'} et) with ≾ₑ-irrelevant e e'
  ... | refl                   = sub-≈ (strˢ-congᵗ A (λ r → hb _) et)
  -- A `sub` coerces the box as well (`app ([]-≤ _)`), but only by moving it
  -- along a different accessibility witness, which `[]-fun-irr` absorbs —
  -- so the box hypothesis is reusable at the coerced box.
  strˢ-congᵗ A {box} {box'} hb (sub-u {t = t}) =
    ≈ᵗ-trans sub-u
      (strˢ-congᵗ A (λ r → ≈-trans A ([]-fun-irr box _ r) (hb r)) (≈ᵗ-refl t))
  strˢ-congᵗ A {box} {box'} hb (sub-∘ {e = e} {e' = e'} {t = t}) =
    ≈ᵗ-trans sub-∘
      (sub-≈ (strˢ-congᵗ A
               (λ r → ≈-trans A
                        ([]-fun-irr box _ (⊑-mono (map-monotoneᵉ (≾ₑ-trans e e')) r))
                        (≈-trans A (hb (⊑-mono (map-monotoneᵉ (≾ₑ-trans e e')) r))
                                   ([]-fun-irr box' _ _)))
               (≈ᵗ-refl t)))
  -- the box the strength carries under the delay is the same on both sides,
  -- up to the accessibility witness it is read at (absorbed by `[]-fun-irr`)
  strˢ-congᵗ A {box} {box'} hb (sub-delay {e = e} {k = k}) =
    ≈ᵗ-trans (sub-delayᵗ e _ _)
      (delay-≈ (λ q → sub-≈ (strˢ-congᵗ A
                 (λ r → ≈-trans A
                          ([]-fun-irr box _
                             (⊑-coe (sym map-·ᵉ)
                                (⊑-trans q (⊑-mono (map-monotoneᵉ e) r))))
                          (hb (⊑-coe (sym map-·ᵉ)
                                (⊑-trans q (⊑-mono (map-monotoneᵉ e) r)))))
                 (≈ᵗ-refl (k q)))))
  -- likewise for the box carried under an operation
  strˢ-congᵗ A {box} {box'} hb (sub-op {op = op} {e = e} {v = v} {k = k}) =
    ≈ᵗ-trans (sub-opᵗ e v _ _ _)
      (op-≈ (≈-refl ⟦ param op ⟧ᵍ)
        (λ q y → sub-≈ (strˢ-congᵗ A
                   (λ r → ≈-trans A
                            ([]-fun-irr box _
                               (⊑-coe (sym map-·ᵉ)
                                  (⊑-trans q (⊑-mono (map-monotoneᵉ e) r))))
                            (hb (⊑-coe (sym map-·ᵉ)
                                  (⊑-trans q (⊑-mono (map-monotoneᵉ e) r)))))
                   (≈ᵗ-refl (k q y)))))
  -- The strength preserves grades, so it leaves both delay collapses in place;
  -- only the box it carries has to be recognised as the same one, read at a
  -- different accessibility witness (`[]-fun-irr`) and through the collapse's
  -- own grade transport (`fun-substᵇ`).
  strˢ-congᵗ A {box} {box'} hb (delay-zero {k = k} {q₀ = q₀} e) =
    ≈ᵗ-trans (delay-zero {q₀ = q₀} e)
    (≈ᵗ-trans (ε-substˢ-congᵗ e
                (strˢ-congᵗ A
                  (λ r → ≈-trans A ([]-fun-irr box _ _) (hb _))
                  (≈ᵗ-refl (k q₀))))
              (≈ᵗ-sym (strˢ-ε-substˢ A e box' (k q₀))))
  strˢ-congᵗ A {box} {box'} hb
             (delay-plus {τ₁ = τ₁} {τ₂ = τ₂} {k = k} {kn = kn} hk e) =
    ≈ᵗ-trans (delay-plus
               (λ q₁ q₂ → strˢ-congᵗ A
                            (λ r → ≈-trans A ([]-fun-irr box _ _) (hb _))
                            (hk q₁ q₂))
               e)
             (≈ᵗ-sym (strˢ-ε-substˢ A e box' (delay-node (τ₁ + τ₂) k kn)))
  strˢ-congᵗ A hb (≈ᵗ-sym et)  =
    ≈ᵗ-sym (strˢ-congᵗ A (λ r → ≈-sym A (hb r)) et)
  strˢ-congᵗ A {box} {box'} hb (≈ᵗ-trans et et') =
    ≈ᵗ-trans (strˢ-congᵗ A {box = box} {box' = box} (λ r → ≈-refl A) et)
             (strˢ-congᵗ A hb et')

  -- Strength is natural in the world (uses the box's `fun-nat` at leaves).

  strˢ-natᵗ : ∀ {B ε w w'} (A : PSh) (a : [ mapᵉ ε ]ᶜ A w) (p : w ⊑[ uᵣ ] w') (t : Tˢ B ε w)
            → strˢ A (transport ([ mapᵉ ε ]ᵒ A) p a) (transportᵗ p t) ≈ᵗ transportᵗ p (strˢ A a t)
  strˢ-natᵗ {B} A a p (leaf b) =
    leaf-≈ (≈-trans A ([]-fun-irr a _ _) (fun-nat a _ p) , ≈-refl B)
  strˢ-natᵗ A a p (op-node op v k kc kn) =
    op-≈ (≈-refl ⟦ param op ⟧ᵍ)
      (λ q y → strˢ-congᵗ A (λ r → []-fun-irr a _ _) (≈ᵗ-refl (k (⊑ᵘ∘ρ p q) y)))
  strˢ-natᵗ A a p (delay-node τ k kn) =
    delay-≈ (λ q → strˢ-congᵗ A (λ r → []-fun-irr a _ _) (≈ᵗ-refl (k (⊑ᵘ∘ρ p q))))
  strˢ-natᵗ A a p (sub e t) =
    sub-≈ (≈ᵗ-trans
      (strˢ-congᵗ A (λ r → []-fun-irr a _ _) (≈ᵗ-refl (transportᵗ p t)))
      (strˢ-natᵗ A (app ([]-≤ (map-monotoneᵉ e)) a) p t))

strᵀ : ∀ {A B ε} → [ mapᵉ ε ]ᵒ A ×ᵖ Tᵒ B ε →ᵖ Tᵒ (A ×ᵖ B) ε
strᵀ {A} {B} {ε} = pmap (λ { (a , t) → strˢ A a t })
            (λ { {x = a , t} {a' , t'} (ea , et) → strˢ-congᵗ A (λ r → ea r) et })
            (λ { p (a , t) → strˢ-natᵗ A a p t })

-- Strength is natural (in the maps). The advanced box and the mapped box
-- share a `fun` but differ in their `fun-nat`, so a `strˢ-congᵗ` bridge
-- reconciles them at each node.

strˢ-nat : ∀ {A A' B B' ε w} → (f : A →ᵖ A') → (g : B →ᵖ B')
         → (box : [ mapᵉ ε ]ᶜ A w) → (t : Tˢ B ε w)
         → strˢ A' (app ([ mapᵉ ε ]ᶠ f) box) (Tˢᶠ g t) ≈ᵗ Tˢᶠ (mapˣᵐ f g) (strˢ A box t)
strˢ-nat {A' = A'} {B' = B'} f g box (leaf b)      = leaf-≈ (≈-refl A' , ≈-refl B')
strˢ-nat {A' = A'} f g box (op-node op v k kc kn)  =
  op-≈ (≈-refl ⟦ param op ⟧ᵍ)
    (λ q y → ≈ᵗ-trans
      (strˢ-congᵗ A' (λ r → ≈-refl A') (≈ᵗ-refl (Tˢᶠ g (k q y))))
      (strˢ-nat f g (box▸ _ q box) (k q y)))
strˢ-nat {A' = A'} f g box (delay-node τ k kn)  =
  delay-≈ (λ q → ≈ᵗ-trans
    (strˢ-congᵗ A' (λ r → ≈-refl A') (≈ᵗ-refl (Tˢᶠ g (k q))))
    (strˢ-nat f g (box▸ _ q box) (k q)))
strˢ-nat {A' = A'} f g box (sub p t)         =
  sub-≈ (≈ᵗ-trans
    (strˢ-congᵗ A' (λ r → ≈-refl A') (≈ᵗ-refl (Tˢᶠ g t)))
    (strˢ-nat f g (app ([]-≤ (map-monotoneᵉ p)) box) t))

strᵀ-nat : ∀ {A A' B B' ε} → (f : A →ᵖ A') → (g : B →ᵖ B')
         → strᵀ {A'} {B'} ∘ᵖ mapˣᵐ ([ mapᵉ ε ]ᶠ f) (Tᶠ g)
         ≈ᵖ Tᶠ (mapˣᵐ f g) ∘ᵖ strᵀ {A} {B}
strᵀ-nat f g (a , t) = strˢ-nat f g a t

-- Strength projects away on the second component

strˢ-snd : ∀ {B ε w} (A : PSh) → (box : [ mapᵉ ε ]ᶜ A w) → (t : Tˢ B ε w)
         → Tˢᶠ sndᵐ (strˢ A box t) ≈ᵗ t
strˢ-snd {B = B} A box (leaf b)          = leaf-≈ (≈-refl B)
strˢ-snd A box (op-node op v k kc kn)  =
  op-≈ (≈-refl ⟦ param op ⟧ᵍ) (λ q y → strˢ-snd A (box▸ A q box) (k q y))
strˢ-snd A box (delay-node τ k kn)  =
  delay-≈ (λ q → strˢ-snd A (box▸ A q box) (k q))
strˢ-snd A box (sub p t)         =
  sub-≈ (strˢ-snd A (app ([]-≤ (map-monotoneᵉ p)) box) t)

strᵀ-sndᵐ : ∀ {A B ε} → Tᶠ sndᵐ ∘ᵖ strᵀ {A} {B} {ε} ≈ᵖ sndᵐ
strᵀ-sndᵐ {A} (a , t) = strˢ-snd A a t

-- Strength unit coherence

strᵀ-ηᵀ : ∀ {A B}
        → strᵀ {A} {B} {uₑ} ∘ᵖ mapˣᵐ idᵖ ηᵀ
        ≈ᵖ ηᵀ {A ×ᵖ B} ∘ᵖ mapˣᵐ (ε ∘ᵖ []-≤ (≾ᵣ-reflexive (sym map-uᵉ))) idᵖ
strᵀ-ηᵀ (box , b) = ≈ᵗ-refl _

-- Associativity with the product

strˢ-assoc : ∀ {C ε w} (A B : PSh)
           → (a : [ mapᵉ ε ]ᶜ A w)
           → (b : [ mapᵉ ε ]ᶜ B w)
           → (t : Tˢ C ε w)
           → Tˢᶠ ×ᵐ-assoc (strˢ (A ×ᵖ B) (app []-monoidal (a , b)) t) ≈ᵗ strˢ A a (strˢ B b t)
strˢ-assoc {C} A B a b (leaf c)          = leaf-≈ (≈-refl (A ×ᵖ B ×ᵖ C))
strˢ-assoc A B a b (op-node op v k kc kn)  =
  op-≈ (≈-refl ⟦ param op ⟧ᵍ)
    (λ q y → ≈ᵗ-trans
      (Tˢᶠ-congᵗ ×ᵐ-assoc (strˢ-congᵗ (A ×ᵖ B) (λ r → ≈-refl A , ≈-refl B) (≈ᵗ-refl (k q y))))
      (strˢ-assoc A B (box▸ A q a) (box▸ B q b) (k q y)))
strˢ-assoc A B a b (delay-node τ k kn)  =
  delay-≈ (λ q → ≈ᵗ-trans
    (Tˢᶠ-congᵗ ×ᵐ-assoc (strˢ-congᵗ (A ×ᵖ B) (λ r → ≈-refl A , ≈-refl B) (≈ᵗ-refl (k q))))
    (strˢ-assoc A B (box▸ A q a) (box▸ B q b) (k q)))
strˢ-assoc A B a b (sub p t)         =
  sub-≈ (≈ᵗ-trans
    (Tˢᶠ-congᵗ ×ᵐ-assoc (strˢ-congᵗ (A ×ᵖ B) (λ r → ≈-refl A , ≈-refl B) (≈ᵗ-refl t)))
    (strˢ-assoc A B (app ([]-≤ (map-monotoneᵉ p)) a) (app ([]-≤ (map-monotoneᵉ p)) b) t))

strᵀ-assoc : ∀ {A B C ε}
           → Tᶠ ×ᵐ-assoc ∘ᵖ strᵀ {A ×ᵖ B} {C} {ε}
             ∘ᵖ mapˣᵐ []-monoidal idᵖ ∘ᵖ ×ᵐ-assoc⁻¹
           ≈ᵖ strᵀ {A} {B ×ᵖ C} {ε} ∘ᵖ mapˣᵐ idᵖ (strᵀ {B} {C} {ε})
strᵀ-assoc {A} {B} (a , b , t) = strˢ-assoc A B a b t

-- Strength commutes with multiplication. Threading the box through `μˢ`
-- agrees with splitting it (via `δ`) and threading the inner layer via
-- `Tˢᶠ strᵀ`. Since the strengthened `A` is here a box `[ mapᵉ ε' ] A`,
-- the two boxes are only `_≈_`-equal, so this is a native `_≈ᵗ_`
-- induction; the outer box `a` and the split box `a'` are related by `rel`.

strˢ-μˢ : ∀ {B ε ε' w} (A : PSh)
        → (a  : [ mapᵉ (ε ·ₑ ε') ]ᶜ A w)
        → (a' : [ mapᵉ ε ]ᶜ ([ mapᵉ ε' ]ᵒ A) w)
        → (rel : ∀ {w1} (p : w ⊑[ mapᵉ ε ] w1) {w2} (q : w1 ⊑[ mapᵉ ε' ] w2)
                 → _≈_ A (fun (fun a' p) q) (fun a (⊑-coe (sym map-·ᵉ) (⊑-trans p q))))
        → (t : Tˢ (Tᵒ B ε') ε w)
        → strˢ A a (μˢ t) ≈ᵗ μˢ (Tˢᶠ (strᵀ {A} {B} {ε'}) (strˢ ([ mapᵉ ε' ]ᵒ A) a' t))
strˢ-μˢ A a a' rel (leaf s) =
  ≈ᵗ-trans
    (strˢ-ε-substˢ A (sym (·ₑ-identityˡ _)) a s)
    (ε-substˢ-congᵗ (sym (·ₑ-identityˡ _))
      (strˢ-congᵗ A (λ r → ≈-trans A ([]-fun-irr a _ _) (≈-sym A (rel _ r))) (≈ᵗ-refl s)))
strˢ-μˢ A a a' rel (op-node op v k kc kn) =
  ≈ᵗ-trans
    (strˢ-ε-substˢ A (sym (·ₑ-assoc _ _ _)) a (op-node op v (λ q y → μˢ (k q y)) _ _))
    (ε-substˢ-congᵗ (sym (·ₑ-assoc _ _ _))
      (op-≈ (≈-refl ⟦ param op ⟧ᵍ)
        (λ q y → strˢ-μˢ A _ _
          (λ p1 p2 → ≈-trans A (rel _ p2) ([]-fun-irr a _ _))
          (k q y))))
strˢ-μˢ A a a' rel (delay-node τ k kn) =
  ≈ᵗ-trans
    (strˢ-ε-substˢ A (sym (·ₑ-assoc _ _ _)) a (delay-node τ (λ q → μˢ (k q)) _))
    (ε-substˢ-congᵗ (sym (·ₑ-assoc _ _ _))
      (delay-≈
        (λ q → strˢ-μˢ A _ _
          (λ p1 p2 → ≈-trans A (rel _ p2) ([]-fun-irr a _ _))
          (k q))))
strˢ-μˢ A a a' rel (sub p₀ t) =
  sub-≈ (strˢ-μˢ A _ _
    (λ p1 p2 → ≈-trans A (rel _ p2) ([]-fun-irr a _ _))
    t)

strᵀ-μᵀ : ∀ {A B ε ε'}
        → strᵀ {A} {B} {ε ·ₑ ε'} ∘ᵖ mapˣᵐ idᵖ (μᵀ {B} {ε} {ε'})
        ≈ᵖ μᵀ {A ×ᵖ B} {ε} {ε'}
          ∘ᵖ Tᶠ (strᵀ {A} {B} {ε'})
          ∘ᵖ strᵀ {[ mapᵉ ε' ]ᵒ A} {Tᵒ B ε'} {ε}
          ∘ᵖ mapˣᵐ (δ ∘ᵖ []-≤ (≾ᵣ-reflexive (sym map-·ᵉ))) idᵖ
strᵀ-μᵀ {A} {ε = ε} {ε' = ε'} (a , t) =
  strˢ-μˢ A a
    (app (δ {A} {mapᵉ ε} {mapᵉ ε'}) (app ([]-≤ (≾ᵣ-reflexive (sym map-·ᵉ))) a))
    (λ p q → ≈-refl A)
    t

-- SUB-EFFECTING IS FUNCTORIAL IN THE GRADE
--
-- `T-≤ p` adds a `sub p` node, and `_≈ᵗ_` collapses those (`sub-u`,
-- `sub-∘`): a coercion node is invisible to the tree equality. That is what
-- makes these laws hold, and it is what the operational soundness proof
-- needs, since reduction discards coercions as it refines effect grades.

T-≤-refl : ∀ {A ε} → (p : ε ≾ₑ ε) → T-≤ {A} p ≈ᵖ idᵖ
T-≤-refl p t = sub-uᵗ p t

T-≤-trans : ∀ {A ε₁ ε₂ ε₃} → (p : ε₁ ≾ₑ ε₂) → (q : ε₂ ≾ₑ ε₃) → (r : ε₁ ≾ₑ ε₃)
          → T-≤ {A} q ∘ᵖ T-≤ {A} p ≈ᵖ T-≤ {A} r
T-≤-trans p q r t = sub-∘ᵗ p q r _

-- The on-the-nose coercion is sub-effecting at a reflexive witness: the
-- transport does nothing, and the `sub` node it is compared against collapses.

T-≤-≡ : ∀ {A ε ε'} → (e : ε ≡ ε') → ε-substᵀ {A} e ≈ᵖ T-≤ (≾ₑ-reflexive e)
T-≤-≡ refl t = ≈ᵗ-sym sub-u

-- Sub-effecting commutes with the multiplication and with the strength;
-- both hold definitionally, as `μˢ` and `strˢ` push a `sub` node outwards
-- (the strength relaxing the box's grade as it goes).

T-≤-μᵀ : ∀ {A ε₁ ε₂ ε'} → (p : ε₁ ≾ₑ ε₂)
       → μᵀ {A} {ε₂} {ε'} ∘ᵖ T-≤ p ≈ᵖ T-≤ (·ₑ-monoˡ-≾ₑ p) ∘ᵖ μᵀ {A} {ε₁} {ε'}
T-≤-μᵀ p t = ≈ᵗ-refl _

-- Sub-effecting also commutes with the multiplication in the *inner* grade,
-- landing on `·ₑ-monoʳ` (dual to the outer law's `·ₑ-monoˡ`). Unlike the outer
-- law this is not definitional: the coercion starts at the leaves and has to
-- migrate out to the root, crossing every node on the way — `sub-delay` at
-- delays and `sub-op` at operations, the latter being what makes the inner
-- grade monotone at all.

μˢ-≤ⁱ : ∀ {A ε ε₁' ε₂' w} → (p : ε₁' ≾ₑ ε₂') → (t : Tˢ (Tᵒ A ε₁') ε w)
      → μˢ (Tˢᶠ (T-≤ p) t) ≈ᵗ sub (·ₑ-monoʳ-≾ₑ p) (μˢ t)
μˢ-≤ⁱ {ε₁' = ε₁'} {ε₂' = ε₂'} p (leaf s) =
  ≈ᵗ-sym (sub-ε-substᵗ (sym (·ₑ-identityˡ ε₁')) (sym (·ₑ-identityˡ ε₂'))
                       p (·ₑ-monoʳ-≾ₑ p) s)
μˢ-≤ⁱ {ε₁' = ε₁'} {ε₂' = ε₂'} p (op-node {ε = ε₀} op v k kc kn) =
  ≈ᵗ-trans
    (ε-substˢ-congᵗ (sym (·ₑ-assoc (op-grade op) ε₀ ε₂'))
      (op-≈ (≈-refl ⟦ param op ⟧ᵍ) (λ q y → μˢ-≤ⁱ p (k q y))))
    (≈ᵗ-trans
      (ε-substˢ-congᵗ (sym (·ₑ-assoc (op-grade op) ε₀ ε₂'))
        (≈ᵗ-sym (sub-opᵗ (·ₑ-monoʳ-≾ₑ p) v _ _ _)))
      (≈ᵗ-sym (sub-ε-substᵗ (sym (·ₑ-assoc (op-grade op) ε₀ ε₁'))
                            (sym (·ₑ-assoc (op-grade op) ε₀ ε₂'))
                            (·ₑ-monoʳ-≾ₑ (·ₑ-monoʳ-≾ₑ p)) (·ₑ-monoʳ-≾ₑ p) _)))
μˢ-≤ⁱ {ε₁' = ε₁'} {ε₂' = ε₂'} p (delay-node {ε = ε₀} τ k kn) =
  ≈ᵗ-trans
    (ε-substˢ-congᵗ (sym (·ₑ-assoc (of-natᵉ τ) ε₀ ε₂'))
      (delay-≈ (λ q → μˢ-≤ⁱ p (k q))))
    (≈ᵗ-trans
      (ε-substˢ-congᵗ (sym (·ₑ-assoc (of-natᵉ τ) ε₀ ε₂'))
        (≈ᵗ-sym (sub-delayᵗ (·ₑ-monoʳ-≾ₑ p) _ _)))
      (≈ᵗ-sym (sub-ε-substᵗ (sym (·ₑ-assoc (of-natᵉ τ) ε₀ ε₁'))
                            (sym (·ₑ-assoc (of-natᵉ τ) ε₀ ε₂'))
                            (·ₑ-monoʳ-≾ₑ (·ₑ-monoʳ-≾ₑ p)) (·ₑ-monoʳ-≾ₑ p) _)))
μˢ-≤ⁱ p (sub p₀ t) =
  ≈ᵗ-trans (sub-≈ (μˢ-≤ⁱ p t))
           (≈ᵗ-trans (sub-∘ᵗ _ (·ₑ-monoˡ-≾ₑ p₀)
                            (≾ₑ-trans (·ₑ-monoʳ-≾ₑ p) (·ₑ-monoˡ-≾ₑ p₀)) _)
                     (≈ᵗ-sym (sub-∘ᵗ _ _
                            (≾ₑ-trans (·ₑ-monoʳ-≾ₑ p) (·ₑ-monoˡ-≾ₑ p₀)) _)))

T-≤-μᵀⁱ : ∀ {A ε ε₁' ε₂'} → (p : ε₁' ≾ₑ ε₂')
        → μᵀ {A} {ε} {ε₂'} ∘ᵖ Tᶠ (T-≤ p) ≈ᵖ T-≤ (·ₑ-monoʳ-≾ₑ p) ∘ᵖ μᵀ {A} {ε} {ε₁'}
T-≤-μᵀⁱ p t = μˢ-≤ⁱ p t

strᵀ-≤ : ∀ {A B ε ε'} → (p : ε ≾ₑ ε')
       → strᵀ {A} {B} {ε'} ∘ᵖ mapˣᵐ idᵖ (T-≤ p)
       ≈ᵖ T-≤ p ∘ᵖ strᵀ {A} {B} {ε} ∘ᵖ mapˣᵐ ([]-≤ (map-monotoneᵉ p)) idᵖ
strᵀ-≤ {A} p (box , t) = ≈ᵗ-refl _
